PORT=8090
# Local development uses private on-disk PostgreSQL (PGlite) when DATABASE_URL is empty.
DATABASE_URL=
# Production: Supabase transaction pooler connection URL, with TLS verification enabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fleetsync-private
# SHA-256 of the one-time hosting setup code, generated locally.
BOOTSTRAP_CODE_HASH=
# Email recovery: Gmail App Password or another authorized SMTP account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
