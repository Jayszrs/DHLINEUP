{
  "name": "dh-fleetsync-node",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:init": "node --env-file-if-exists=.env backend/cli/init-db.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "node backend/cli/prepare-assets.js",
    "pretest": "npm run build",
    "prestart": "npm run build",
    "predev": "npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "csv-parse": "^7.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "mysql2": "^3.24.6",
    "supertest": "^7.3.1"
  }
}
