<div class="catalog-field" data-search-select data-category="<%= category %>">
  <label for="catalog-<%= field %>"><%= label %><%= required?' *':'' %></label>
  <div class="catalog-control">
    <input id="catalog-<%= field %>" name="<%= field %>" value="<%= row[field] || '' %>" maxlength="<%= category==='unit'?60:100 %>" <%= required?'required':'' %> autocomplete="off" placeholder="<%= category==='unit'?'Cari nomor unit...':'Cari atau ketik '+label.toLowerCase()+'...' %>" list="catalog-<%= field %>-fallback" aria-describedby="catalog-<%= field %>-help">
    <button type="button" class="catalog-toggle" aria-label="Buka pilihan <%= label.toLowerCase() %>" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
  <datalist id="catalog-<%= field %>-fallback"><% for(const option of equipmentCatalog[category]) { %><option value="<%= option %>"></option><% } %></datalist>
  <div class="catalog-popup" hidden><div class="catalog-options" id="catalog-<%= field %>-options" role="listbox" aria-label="<%= label %>"></div><p class="catalog-empty" hidden>Pilihan belum ada. Ketik nilai baru untuk menggunakannya.</p><% if(category!=='unit') { %><button type="button" class="catalog-add" data-catalog-add hidden>Tambah <%= label.toLowerCase() %></button><% } %></div></div>
  <div class="catalog-help"><small id="catalog-<%= field %>-help"><%= category==='unit'?'Nomor DT dari daftar unit; unit lain tetap bisa diketik.':'Pilihan baru bisa ditambahkan ke daftar bersama.' %></small></div>
  <small class="catalog-feedback" role="status" aria-live="polite"></small>
</div>
