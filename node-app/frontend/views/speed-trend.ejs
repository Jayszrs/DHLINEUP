<section class="speed-chart"><div class="section-heading"><h3>Tren rata-rata speed</h3><span><i class="chart-key all"></i>Semua <i class="chart-key moving"></i>Bergerak</span></div>
<% const plotted=speedDaily.filter(r=>r.average!==null),max=Math.max(1,...plotted.map(r=>r.moving_average||0))*1.15; const points=key=>plotted.map((r,i)=>`${44+(plotted.length>1?i*812/(plotted.length-1):406)},${212-(r[key]||0)*180/max}`).join(' '); %>
<% if(plotted.length) { %><svg class="speed-trend" viewBox="0 0 900 260" role="img" aria-label="Rata-rata speed semua pembacaan dan saat bergerak per tanggal, satuan kilometer per jam"><% for(let i=0;i<=4;i++) {const y=212-i*45; %><line x1="44" y1="<%= y %>" x2="856" y2="<%= y %>" class="chart-grid"/><text x="34" y="<%= y+4 %>" text-anchor="end"><%= speedNumber(max*i/4,1) %></text><% } %><polyline points="<%= points('moving_average') %>" class="speed-line moving"/><polyline points="<%= points('average') %>" class="speed-line all"/><text x="44" y="242"><%= dateId(plotted[0].work_date,true) %></text><text x="856" y="242" text-anchor="end"><%= dateId(plotted.at(-1).work_date,true) %></text></svg><% } else { %><p class="speed-empty">Belum ada pembacaan dalam periode ini. Ubah filter atau tambahkan rekap harian.</p><% } %>
</section>
