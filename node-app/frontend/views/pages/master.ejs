<section><div class="page-title"><div><h2>Master Operator <span>· <%= filters.site %></span></h2><p>Profil operator dan penugasan terakhir. Identitas pada riwayat Line Up tetap disimpan sebagai snapshot.</p></div><a class="btn primary" href="<%= url('operator-form') %>">Tambah Operator</a></div>
<form class="master-toolbar" method="get" action="<%= url('master') %>"><label class="site-filter">District<select name="site"><%- include('../options',{values:SITES,selected:filters.site}) %></select></label><div class="search-field"><input name="search" aria-label="Cari master operator" placeholder="Cari NIK, nama operator, kode unit..." value="<%= filters.search %>"></div><button class="subtle-button" type="submit">Cari</button><a class="subtle-button" href="<%= url('export',{...filters,kind:'master'}) %>">Ekspor Excel</a><a class="subtle-button" href="<%= url('master') %>">Reset</a></form><div class="master-summary"><%= rows.length %> operator terdata</div>
<div class="table-outer"><div class="table-scroll"><table class="data-table"><caption class="sr-only">Master Operator</caption><thead><tr><% for(const label of ['NAMA OPERATOR','NIK','UNIT TERAKHIR','JENIS ALAT','TANGGAL','AKSI']) { %><th scope="col"><%= label %></th><% } %></tr></thead><tbody>
<% for(const row of rows) { %><tr><td><span class="operator-name"><%= row.name || 'Belum diisi' %></span></td><td><%= row.nik %></td><td><strong><%= row.unit || '-' %></strong></td><td><%= row.equipment || '-' %></td><td><%= dateId(row.last_date) %></td><td><a class="table-action" href="<%= url('operator-form',{id:row.id}) %>">Edit &rsaquo;</a></td></tr><% } %></tbody></table>
<% if(!rows.length) { %><div class="empty-state"><h3>Belum ada operator yang sesuai</h3><p>Ubah pencarian atau tambahkan operator untuk district ini.</p><a class="subtle-button" href="<%= url('operator-form') %>">Tambah Operator</a></div><% } %></div></div></section>
