<section><div class="page-title"><div><h2>Operator <span>· <%= filters.site %></span></h2><p>Kelola identitas operator dan penugasan terakhir. Klik nama untuk membuka profil.</p></div><% if(canEditData) { %><a class="btn primary" href="<%= url('operator-form') %>">Tambah Operator</a><% } %></div>
<form class="master-toolbar" method="get" action="<%= url('master') %>"><label class="site-filter">District<select name="site"><%- include('../options',{values:SITES,selected:filters.site}) %></select></label><div class="search-field"><input name="search" aria-label="Cari operator" placeholder="Cari NIK, nama operator, kode unit..." value="<%= filters.search %>"></div><button class="subtle-button" type="submit">Cari</button><a class="subtle-button" href="<%= url('export',{...filters,kind:'master'}) %>">Ekspor Excel</a><a class="subtle-button" href="<%= url('master') %>">Reset</a></form><div class="master-summary"><%= rows.length %> operator terdata</div>
<div class="table-outer"><div class="table-scroll"><table class="data-table operator-table"><caption class="sr-only">Operator</caption><thead><tr><% for(const label of ['NAMA OPERATOR','NIK','UNIT TERAKHIR','JENIS / TIPE ALAT','TANGGAL','AKSI']) { %><th scope="col"><%= label %></th><% } %></tr></thead><tbody>
<% for(const row of rows) { %><tr><td><a class="record-link operator-name" href="<%= url('operator-form',{id:row.id}) %>"><%= row.name || 'Belum diisi' %></a></td><td><%= row.nik %></td><td><strong><%= row.unit || '-' %></strong></td><td><%= row.equipment || '-' %><% if(row.equipment_kind) { %><small><%= row.equipment_kind %></small><% } %></td><td><%= dateId(row.last_date) %></td><td><div class="record-actions"><% if(canEditData) { %><a class="table-action" href="<%= url('operator-form',{id:row.id}) %>" aria-label="Edit operator <%= row.name %>">Edit</a><form method="post" action="<%= url('operator-delete') %>" data-confirm="Hapus profil operator <%= row.name || row.nik %>? Riwayat Line Up tetap disimpan. Tindakan ini menghapus profil dari daftar Operator."><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="row-delete" type="submit" aria-label="Hapus operator <%= row.name || row.nik %>">Hapus</button></form><% } else { %><span class="muted">Lihat saja</span><% } %></div></td></tr><% } %></tbody></table>
<% if(!rows.length) { %><div class="empty-state"><h3>Belum ada operator yang sesuai</h3><p>Ubah pencarian atau pilih district lain.</p><% if(canEditData) { %><a class="subtle-button" href="<%= url('operator-form') %>">Tambah Operator</a><% } %></div><% } %></div></div></section>
