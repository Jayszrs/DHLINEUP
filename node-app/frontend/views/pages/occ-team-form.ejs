<section class="editor-page"><div class="page-title"><div><h1>Profil <%= row.name %></h1><p><%= row.nik %> · <%= row.role %></p></div><a class="subtle-button" href="<%= url('occ-dashboard') %>">Kembali ke OCC</a></div>
<form class="editor-form" action="<%= url('occ-team-save') %>" method="post" enctype="multipart/form-data" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="nik" value="<%= row.nik %>"><input type="hidden" name="version" value="<%= row.version %>"><div class="form-grid">
<div class="full-span profile-photo-field" data-evidence-upload data-noun="Foto profil" data-current-url="<%= row.photo_path?url('occ-team-photo',{nik:row.nik}):'' %>" data-label="foto profil tim" data-max-bytes="2097152"><label>Foto profil asli<input type="file" name="profile_photo" accept="image/png,image/jpeg,image/webp" data-evidence-file></label><small>PNG, JPG, atau WebP; maksimal 2 MB. Foto akun yang cocok dipakai jika belum ada unggahan khusus tim.</small><div class="upload-preview profile-photo-preview" data-evidence-preview hidden></div><p data-evidence-status role="status">Pilih foto untuk melihat preview.</p><button type="button" class="subtle-button" data-evidence-clear data-evidence-control hidden>Batalkan pilihan foto</button><% if(row.own_photo){ %><label class="checkbox-label"><input type="checkbox" name="remove_profile_photo" value="1" data-evidence-remove data-evidence-control>Hapus foto khusus tim saat menyimpan</label><% } %></div>
<label>Status profil<select name="work_status"><%- include('../options',{values:teamStatuses,selected:row.work_status}) %></select><small>Status diperbarui secara manual; bukan presensi otomatis.</small></label><label class="full-span">Bio<textarea name="bio" rows="5" maxlength="2000" placeholder="Tulis bio atau tanggung jawab anggota tim"><%= row.bio %></textarea></label></div><div class="modal-actions"><button class="btn primary" type="submit">Simpan profil tim</button></div></form></section>
