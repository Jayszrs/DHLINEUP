<section class="editor-page"><div class="page-title"><div><h2><%= label %></h2><p>Isi rekap satu unit untuk satu tanggal. Rata-rata dihitung dari jumlah speed dan catatan.</p></div><a class="subtle-button" href="<%= url('speed-units') %>">Daftar unit</a></div>
<form method="post" action="<%= url('speed-save') %>" class="editor-form" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= row.version||0 %>"><div class="form-grid">
<label>Unit DT *<input name="unit" required maxlength="60" list="speed-unit-options" pattern="[dD][tT][0-9]{1,8}" value="<%= row.unit %>" <%= Number(row.version)>0?'readonly':'' %>><datalist id="speed-unit-options"><% for(const u of speedUnits) { %><option value="<%= u.unit %>"></option><% } %></datalist></label><label>Tanggal *<input type="date" name="work_date" required min="1900-01-01" value="<%= row.work_date %>" <%= Number(row.version)>0?'readonly':'' %>></label>
<% for(const [name,label,step,max] of [['total_count','Jumlah catatan','1',100000000],['moving_count','Catatan bergerak','1',100000000],['speed_sum','Jumlah seluruh pembacaan speed (Σ)','0.0001',50000000000],['max_speed','Speed tertinggi (km/jam)','0.0001',500]]) { %><label><%= label %> *<input type="number" name="<%= name %>" min="0" max="<%= max %>" step="<%= step %>" required value="<%= row[name] %>"></label><% } %></div><p class="fineprint">Berhenti = jumlah catatan − bergerak. Gunakan jumlah pembacaan speed, bukan nilai rata-rata. Pastikan nilai sesuai sumber GPS Anda.</p><div class="modal-actions"><a class="subtle-button" href="<%= url('speed-units') %>">Batal</a><button class="btn primary" type="submit">Simpan rekap speed</button></div></form>
<% if(Number(row.version)>0) { %><form class="delete-form" method="post" action="<%= url('speed-delete') %>" data-confirm="Hapus rekap harian <%= row.unit %> tanggal <%= row.work_date %>? Arsip spreadsheet sumber tetap disimpan."><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="unit" value="<%= row.unit %>"><input type="hidden" name="work_date" value="<%= row.work_date %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="danger-button" type="submit">Hapus rekap harian</button></form><% } %></section>
