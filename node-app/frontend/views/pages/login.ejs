<h1>Masuk ke DH Line Up</h1><p class="muted">Gunakan akun Pengelola untuk melanjutkan pekerjaan.</p>
<form method="post" action="<%= url('login') %>" class="auth-form"><input type="hidden" name="csrf" value="<%= csrf %>">
<label>Username<input name="username" required maxlength="80" autocomplete="username" value="<%= values.username || '' %>"></label>
<label>Password<input type="password" name="password" required maxlength="128" autocomplete="current-password"></label>
<button class="btn primary" type="submit">Masuk</button></form>
<a class="auth-link" href="<%= url('forgot-password') %>">Lupa password?</a>
