<section><div class="page-title"><div><h2>Riwayat perubahan</h2><p>200 aktivitas terakhir dari seluruh Pengelola.</p></div></div><div class="table-outer"><div class="table-scroll"><table class="data-table"><caption class="sr-only">Riwayat Perubahan</caption><thead><tr><% for(const heading of ['WAKTU (WIB)','PENGGUNA','AKSI','ENTITAS','DETAIL']) { %><th scope="col"><%= heading %></th><% } %></tr></thead><tbody>
<% for(const row of rows) { %><tr><td class="date-cell"><%= new Date(row.created_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><%= row.user_name || 'Sistem' %></td><td><%= row.action %></td><td><%= row.entity_type %><small><%= row.entity_id %></small></td><td class="preserve-lines"><%= JSON.stringify(row.details) %></td></tr><% } %></tbody></table><% if(!rows.length) { %><div class="empty-state"><h3>Belum ada riwayat perubahan</h3></div><% } %></div></div></section>
