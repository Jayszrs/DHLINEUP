<section><div class="page-title"><div><h2>Dokumentasi FTW &amp; Mine Dispatch</h2><p>Bukti dari spreadsheet sumber dan unggahan pengguna.</p></div><div class="count-tag"><%= rows.reduce((n,r)=>n+Number(Boolean(r.proof_ftw))+Number(Boolean(r.proof_mine)),0) %> gambar tersedia</div></div>
<form class="docs-toolbar" method="get" action="<%= url('dokumentasi') %>"><label class="site-filter">District<select name="site"><%- include('../options',{values:SITES,selected:filters.site}) %></select></label><div class="search-field"><input name="search" aria-label="Cari dokumentasi" placeholder="Cari kode alat, operator, NIK..." value="<%= filters.search %>"></div><label class="compact-date">Tanggal<input type="date" name="work_date" value="<%= filters.work_date %>"></label><button class="subtle-button" type="submit">Cari</button><a class="subtle-button" href="<%= url('dokumentasi') %>">Reset</a></form>
<% if(rows.some(r=>r.source_row)) { %><div class="reference-panel"><div class="section-mini-title">REFERENSI GAMBAR · TAB 27</div><div class="references"><% for(const [file,label] of Object.entries({'Kolom_1_image2.png':'Contoh Line Up','Kolom_7_image1.png':'Contoh FTW','Kolom_19_image3.png':'Keterangan warna'})) { %><figure><a href="<%= evidenceUrl('reference/'+file) %>" data-lightbox><img loading="lazy" src="<%= evidenceUrl('reference/'+file) %>" alt="<%= label %>"></a><figcaption><%= label %></figcaption></figure><% } %></div></div><% } %>
<div class="evidence-list"><% for(const row of rows) { %><article class="evidence-card"><header><div><strong><%= row.unit %> <span>· <%= dateId(row.work_date) %></span></strong><small><%= row.operator_name %> / NIK <%= row.nik || '-' %></small></div><a class="subtle-button small" href="<%= url('detail',{id:row.id}) %>">Periksa &rsaquo;</a></header><div class="evidence-columns"><%- include('../evidence',{title:'BUKTI FTW',name:row.proof_ftw}) %><%- include('../evidence',{title:'BUKTI MINE DISPATCH',name:row.proof_mine}) %></div><div class="evidence-caption">Bukti visual tidak otomatis menandakan FTW terisi.</div></article><% } %></div>
<% if(!rows.length) { %><div class="empty-state"><h3>Tidak ada dokumentasi yang sesuai</h3><p>Ubah pencarian atau tambahkan bukti lewat Edit Line Up.</p><a class="subtle-button" href="<%= url('lineup') %>">Buka Line Up</a></div><% } %></section>
