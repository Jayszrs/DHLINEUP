<% const mine=rows.filter(r=>r.mine==='Ya').length,ftw=rows.filter(r=>r.ftw==='Ya').length,needs=rows.filter(r=>status(r)[0]!=='SESUAI').length; %>
<section><form method="get" action="<%= url('lineup') %>" id="lineup-filters"><div class="orange-panel"><h1>Line Up Operator</h1><p class="filter-intro">Penugasan operator dan pengecekan Mine Dispatch / FTW.</p>
<div class="orange-controls"><label class="select-box"><span class="field-caption">District</span><span class="select-wrap"><select name="site"><%- include('../options',{values:SITES,selected:filters.site}) %></select></span></label>
<label class="select-box"><span class="field-caption">Tanggal</span><span class="date-wrap"><input type="date" name="work_date" value="<%= filters.work_date %>"></span></label>
<label class="select-box"><span class="field-caption">Shift</span><span class="select-wrap"><select name="shift"><%- include('../options',{values:{All:'Semua shift',D:'D - Day',N:'N - Night','Belum ditentukan':'Belum ditentukan'},selected:filters.shift}) %></select></span></label>
<label class="select-box"><span class="field-caption">Jenis</span><span class="select-wrap"><select name="type_category"><%- include('../options',{values:{All:'Semua jenis',Production:'Production',Support:'Support','Belum diklasifikasi':'Belum diklasifikasi'},selected:filters.type_category}) %></select></span></label>
<button class="btn show-button" type="submit">Tampilkan</button><a class="btn export-button" href="<%= url('export',filters) %>">Ekspor Excel</a><a class="btn reset-button" href="<%= url('lineup') %>">Reset</a></div>
<div class="orange-summary"><span>Zona waktu: <b>WIB</b></span><span>Tanggal: <b><%= filters.work_date?dateId(filters.work_date):'Semua tanggal' %></b></span><span>District: <b><%= filters.site %></b></span><span>Total: <b><%= rows.length %></b></span><span>Mine: <b><%= mine %></b></span><span>FTW: <b><%= ftw %></b></span><span>Perlu cek: <b><%= needs %></b></span></div></div>
<div class="list-toolbar"><div class="search-field"><input name="search" aria-label="Cari unit atau operator" placeholder="Cari unit, operator, NIK, atau catatan..." value="<%= filters.search %>"><button class="search-submit" type="submit">Cari</button></div><div class="toolbar-actions"><span><%= rows.length %> dari <%= total %> entri</span><% if(canEditData) { %><a class="subtle-button" href="<%= url('import') %>">Impor Excel / CSV</a><% } %><a class="subtle-button" href="<%= url('export',{...filters,format:'csv'}) %>">CSV</a></div></div></form>
<div class="table-outer"><div class="table-scroll"><table class="data-table lineup-table"><caption class="sr-only">Line Up Operator hasil filter. Klik nama operator atau unit untuk membuka detail.</caption><thead><tr><% for(const heading of ['TANGGAL','UNIT','JENIS','OPERATOR / NIK','MINE','FTW','STATUS','AKSI']) { %><th scope="col"><%= heading %></th><% } %></tr></thead><tbody>
<% for(const row of rows) { const [label,tone]=status(row); %><tr><td class="date-cell"><%= dateId(row.work_date,true) %></td><td><a class="record-link unit-label" href="<%= url('detail',{id:row.id}) %>"><%= row.unit %></a></td><td><%= row.equipment || '-' %></td><td><a class="record-link operator-name" href="<%= url('detail',{id:row.id}) %>"><%= row.operator_name || 'Belum diisi' %></a><small>NIK <%= row.nik || '-' %></small></td><% for(const key of ['mine','ftw']) { %><td><span class="chip <%= chipTone(row[key]) %>"><%= row[key] %></span></td><% } %><td><span class="status-label <%= tone %>"><%= label %></span></td><td><div class="record-actions"><a class="table-action" href="<%= url('detail',{id:row.id}) %>" aria-label="Detail <%= row.unit %>">Detail</a><% if(canEditData) { %><a class="table-action" href="<%= url('lineup-form',{id:row.id}) %>" aria-label="Edit <%= row.unit %>">Edit</a><form method="post" action="<%= url('lineup-delete') %>" data-confirm="Hapus Line Up <%= row.unit %> untuk <%= row.operator_name || 'operator ini' %>? Tindakan ini tidak dapat dibatalkan."><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="row-delete" type="submit" aria-label="Hapus Line Up <%= row.unit %>">Hapus</button></form><% } %></div></td></tr><% } %></tbody></table>
<% if(!rows.length) { %><div class="empty-state"><h3>Tidak ada data yang sesuai</h3><p>Ubah district, tanggal, shift, jenis, atau kata pencarian. <%= canEditData?'Gunakan Input Line Up untuk menambahkan catatan.':'Akun ini memiliki akses lihat data.' %></p><a class="subtle-button" href="<%= url('lineup') %>">Reset filter</a></div><% } %></div></div><p class="table-footnote"><%= rows.length %> penugasan · FTW dinilai terpisah dari Mine Dispatch · Ekspor mengikuti filter yang sudah diterapkan.</p></section>
