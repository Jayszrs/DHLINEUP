<section><div class="page-title detail-heading"><div><h2><%= row.unit %> <span>· <%= dateId(row.work_date) %></span></h2><p>Site <%= row.site %> / <%= row.shift %> / <%= row.type_category %></p></div><div class="row-buttons"><% if(canEditData) { %><a class="btn primary" href="<%= url('lineup-form',{id:row.id}) %>">Edit</a><% } %><a class="subtle-button" href="<%= url('lineup',{site:row.site}) %>">Kembali</a></div></div>
<div class="identity-grid"><% for(const [key,label] of Object.entries({unit:'KODE ALAT',equipment:'JENIS ALAT',operator_name:'NAMA OPERATOR',nik:'NIK OPERATOR'})) { %><div><small><%= label %></small><strong><%= row[key] || '-' %></strong></div><% } %></div>
<div class="status-grid"><% for(const [key,label] of Object.entries({dh:'DH LINE UP',mine:'MINE DISPATCH',ftw:'FTW TERISI'})) { %><div><small><%= label %></small><span class="chip <%= chipTone(row[key]) %>"><%= row[key] %></span></div><% } const [statusLabel,tone]=status(row); %><div><small>HASIL PENGECEKAN</small><span class="status-label <%= tone %>"><%= statusLabel %></span></div></div>
<div class="evidence-columns detail-evidence"><%- include('../evidence',{title:'BUKTI FTW',name:row.proof_ftw}) %><%- include('../evidence',{title:'DOKUMENTASI MINE DISPATCH',name:row.proof_mine}) %></div>
<p class="fineprint">Sumber: <%= row.source %><%= row.source_row?' · Baris '+row.source_row:'' %> · Diperbarui <%= new Date(row.updated_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %> WIB · Versi <%= row.version %></p></section>
