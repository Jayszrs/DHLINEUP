<section class="<%= speedPage==='speed-dashboard'?'speed-dashboard-content':'' %>"><div class="page-title"><div><h1><%= speedPage==='speed-unit'?speedFilters.unit:label %></h1><p>Recap Fleet Speed Monitoring · Bengalon Coal Project</p></div><div class="row-buttons"><% if(canEditData) { %><% if(speedPage==='speed-dashboard') { %><a class="subtle-button" href="<%= url('speed-import') %>">Impor Excel / CSV</a><% } %><a class="btn primary" href="<%= url('speed-form',speedFilters.unit?{unit:speedFilters.unit}:{}) %>">Input rekap speed</a><% } %><a class="subtle-button" href="<%= url('speed-export',{...speedFilters,kind:speedPage==='speed-monthly'?'monthly':speedPage==='speed-units'?'units':'daily'}) %>"><%= speedPage==='speed-unit'?'Ekspor rekap CSV':'Ekspor CSV' %></a></div></div>
<%- include('../speed-filters') %><%- include('../speed-metrics') %>
<% if(speedPage==='speed-dashboard') { %>
<%- include('../fleet-scene',{sceneKind:'speed',sceneData:speedSceneData,sceneAction:url('speed-dashboard'),sceneFilters:{from:speedFilters.from,to:speedFilters.to}}) %>
<%- include('../speed-periods') %>
<p class="speed-context"><strong><%= speedUnits.length %> unit terdaftar</strong><span><%= speedSummary.active_units||0 %> unit dengan catatan dalam periode ini</span><span><%= speedNumber(speedSummary.moving_count,0) %> bergerak · <%= speedNumber(speedSummary.stopped_count,0) %> berhenti</span></p>
<%- include('../speed-comparison') %><%- include('../speed-trend') %>
<div class="section-heading"><h3>Rekap bulanan</h3><a class="table-action" href="<%= url('speed-monthly',speedFilters) %>">Buka rekap bulanan</a></div><%- include('../speed-table',{tableTitle:'Ringkasan bulanan fleet',tableRows:speedMonthly,firstLabel:'Bulan',showUnits:false,showActions:false}) %>
<div class="section-heading"><h3>Rekap harian terbaru</h3><a class="table-action" href="<%= url('speed-daily',speedFilters) %>">Semua tanggal</a></div><%- include('../speed-table',{tableTitle:'Tujuh tanggal terbaru dalam filter',tableRows:speedDaily.slice(-7).reverse(),firstLabel:'Tanggal',showUnits:true,showActions:false}) %>
<div class="section-heading"><h3>10 unit dengan rata-rata tertinggi</h3><a class="table-action" href="<%= url('speed-units',speedFilters) %>">Semua unit</a></div><%- include('../speed-table',{tableTitle:'Ringkasan unit speed',tableRows:speedUnits.filter(r=>r.total_count>0).sort((a,b)=>(b.average||0)-(a.average||0)).slice(0,10),firstLabel:'Unit',showUnits:false,showActions:false}) %>
<% } else if(speedPage==='speed-units') { %>
<p class="speed-context"><strong><%= speedUnits.length %> unit</strong><span>Klik nomor DT untuk membuka rekap harian dan pembacaan GPS.</span></p><div class="table-outer"><div class="table-scroll"><table class="data-table speed-unit-table"><caption class="sr-only">Daftar unit speed</caption><thead><tr><th>Unit DT</th><th>Fleet</th><th>Catatan rekap</th><th>GPS tersedia</th><th>Rata-rata semua</th><th>Rata-rata bergerak</th><th>Speed tertinggi</th><th>Mulai</th><th>Terakhir</th><th>Keterangan</th></tr></thead><tbody><% for(const r of speedUnits) { %><tr><td><a class="record-link unit-label" href="<%= url('speed-unit',{unit:r.unit}) %>"><%= r.unit %></a></td><td><%= r.fleet %></td><td><%= speedNumber(r.total_count,0) %></td><td><%= speedNumber(r.raw_count,0) %></td><td><%= speedNumber(r.average) %></td><td><%= speedNumber(r.moving_average) %></td><td><%= speedNumber(r.max_speed) %></td><td><%= dateId(r.first_date,true) %></td><td><%= dateId(r.last_date,true) %></td><td><%= r.note || (r.total_count?'Rekap tersedia':'Belum ada rekap GPS') %></td></tr><% } %></tbody></table></div></div>
<% } else if(speedPage==='speed-unit') { %>
<div class="speed-unit-heading"><p><%= speedUnit.fleet %> · <%= speedUnit.site %><% if(speedUnit.note) { %> · <%= speedUnit.note %><% } %></p><% if(speedUnit.source_gid) { %><a class="table-action" href="https://docs.google.com/spreadsheets/d/1fPeEBkAP2mKc-yXhDUnFvWpfi7OFw8CYuYygO1QKqmo/edit#gid=<%= speedUnit.source_gid %>" target="_blank" rel="noopener noreferrer">Tab spreadsheet sumber</a><% } %></div>
<nav class="speed-tabs" aria-label="Laporan unit"><a href="<%= url('speed-unit',{...speedFilters,tab:'recap'}) %>" <%- tab==='recap'?'aria-current="page"':'' %>>Rekap harian</a><a href="<%= url('speed-unit',{...speedFilters,tab:'gps'}) %>" <%- tab==='gps'?'aria-current="page"':'' %>>Pembacaan GPS · <%= speedNumber(gps.total,0) %></a></nav>
<% if(tab==='recap') { %><%- include('../speed-trend') %><%- include('../speed-table',{tableTitle:'Rekap harian '+speedFilters.unit,tableRows:speedDaily,firstLabel:'Tanggal',showUnits:false,showActions:canEditData}) %><% } else { %>
<p class="fineprint">Rekap harian mengikuti angka terverifikasi pada spreadsheet. Pembacaan GPS ditampilkan sesuai baris yang tersedia pada tab unit, sehingga jumlahnya dapat berbeda.</p>
<div class="table-outer"><div class="table-scroll"><table class="data-table speed-gps-table"><caption class="sr-only">Pembacaan GPS <%= speedFilters.unit %></caption><thead><tr><% for(const h of gps.headers) { %><th><%= h %></th><% } %></tr></thead><tbody><% for(const r of gps.rows) { %><tr><% for(const c of r) { %><td title="<%= c %>"><%= c %></td><% } %></tr><% } %></tbody></table><% if(!gps.rows.length) { %><div class="empty-state"><h3>Tidak ada baris GPS pada periode ini</h3><p>Periksa rekap harian atau ubah tanggal filter.</p></div><% } %></div></div>
<nav class="speed-pagination" aria-label="Halaman pembacaan GPS"><% if(gps.page>1) { %><a class="subtle-button" href="<%= url('speed-unit',{...speedFilters,tab:'gps',raw_page:gps.page-1}) %>">Sebelumnya</a><% } %><span>Halaman <%= gps.page %> dari <%= gps.pages %> · <%= speedNumber(gps.total,0) %> pembacaan</span><% if(gps.page<gps.pages) { %><a class="subtle-button" href="<%= url('speed-unit',{...speedFilters,tab:'gps',raw_page:gps.page+1}) %>">Berikutnya</a><% } %></nav>
<% } %>
<% } else { %><% if(speedPage==='speed-daily') { %><%- include('../speed-trend') %><% } %><%- include('../speed-table',{tableTitle:label,tableRows:speedPage==='speed-monthly'?speedMonthly:speedDaily,firstLabel:speedPage==='speed-monthly'?'Bulan':'Tanggal',showUnits:speedPage==='speed-daily',showActions:false}) %><% } %>
<p class="table-footnote">Satuan speed: km/jam. Rata-rata semua = Σ speed ÷ jumlah catatan; rata-rata bergerak = Σ speed ÷ catatan bergerak. Perubahan spreadsheet setelah salinan ini tidak tersinkron otomatis.</p></section>
