<section class="editor-page"><div class="page-title"><div><h2><%= row.id?'Edit':'Input' %> DH Line Up</h2><p>Pencatatan operator dan verifikasi sumber.</p></div><a class="subtle-button" href="<%= row.id?url('detail',{id:row.id}):url('lineup') %>">Kembali</a></div>
<form method="post" action="<%= url('lineup-save') %>" enctype="multipart/form-data" class="editor-form" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>">
<div class="form-grid"><label>District<select name="site"><%- include('../options',{values:SITES,selected:row.site}) %></select></label><label>Tanggal *<input type="date" name="work_date" required value="<%= row.work_date %>"></label>
<label>Shift<select name="shift"><%- include('../options',{values:SHIFTS,selected:row.shift}) %></select></label><label>Jenis penugasan<select name="type_category"><%- include('../options',{values:CATEGORIES,selected:row.type_category}) %></select></label>
<% for(const [key,label,max] of [['unit','Kode Alat *',60],['equipment','Jenis Alat',100],['operator_name','Nama Operator',150],['nik','NIK Operator',60]]) { %><label><%= label %><input name="<%= key %>" maxlength="<%= max %>" value="<%= row[key] %>" <%= key==='unit'?'required':'' %>></label><% } %>
<% for(const [key,label] of Object.entries({dh:'DH Line Up',mine:'Mine Dispatch',ftw:'FTW Terisi'})) { %><label><%= label %><select name="<%= key %>"><%- include('../options',{values:STATUSES,selected:row[key]}) %></select></label><% } %>
<label>Status Sumber<input name="source_status" maxlength="150" value="<%= row.source_status %>"></label><label class="full-span">Catatan<textarea name="note" rows="4" maxlength="10000"><%= row.note %></textarea></label>
<% for(const [key,label] of Object.entries({proof_ftw:'Bukti FTW',proof_mine:'Bukti Mine Dispatch'})) { %><div class="upload-field"><label><%= label %><input type="file" name="<%= key %>" accept="image/png,image/jpeg,image/webp"><small>PNG, JPG, WebP. Maksimal 5 MB.</small></label><% if(row[key]) { %><a class="attached" data-lightbox href="<%= evidenceUrl(row[key]) %>">Lihat bukti saat ini</a><label class="checkbox-label"><input type="checkbox" name="remove_<%= key %>" value="1">Lepas bukti dari catatan ini</label><% } %></div><% } %></div>
<p class="fineprint">Gambar tidak otomatis mengubah status FTW atau Mine Dispatch.</p><div class="modal-actions"><a class="subtle-button" href="<%= url('lineup') %>">Batal</a><button class="btn primary" type="submit">Simpan Line Up</button></div></form>
<% if(row.id) { %><form class="delete-form" method="post" action="<%= url('lineup-delete') %>" data-confirm="Hapus Line Up ini dari database? Tindakan ini tidak dapat dibatalkan."><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="danger-button" type="submit">Hapus Line Up</button></form><% } %></section>
