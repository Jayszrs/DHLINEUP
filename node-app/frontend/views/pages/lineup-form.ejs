<section class="editor-page"><div class="page-title"><div><h2><%= row.id?'Edit':'Input' %> DH Line Up</h2><p>Penugasan operator dan bukti pengecekan.</p></div><a class="subtle-button" href="<%= row.id?url('detail',{id:row.id}):url('lineup') %>">Kembali</a></div>
<form method="post" action="<%= url('lineup-save') %>" enctype="multipart/form-data" class="editor-form" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>">
<div class="form-grid"><label>District<select name="site"><%- include('../options',{values:SITES,selected:row.site}) %></select></label><label>Tanggal *<input type="date" name="work_date" required value="<%= row.work_date %>"></label>
<label>Shift<select name="shift"><%- include('../options',{values:SHIFTS,selected:row.shift}) %></select></label><label>Jenis penugasan<select name="type_category"><%- include('../options',{values:CATEGORIES,selected:row.type_category}) %></select></label>
<% for(const [key,label,max] of [['unit','Kode Alat *',60],['equipment','Jenis Alat',100],['operator_name','Nama Operator',150],['nik','NIK Operator',60]]) { %><label><%= label %><input name="<%= key %>" maxlength="<%= max %>" value="<%= row[key] %>" <%= key==='unit'?'required':'' %>></label><% } %>
<div class="status-inputs full-span"><% for(const [key,label] of Object.entries({dh:'DH Line Up',mine:'Mine Dispatch',ftw:'FTW Terisi'})) { %><label><%= label %><select name="<%= key %>"><%- include('../options',{values:STATUSES,selected:row[key]}) %></select></label><% } %></div>
<div class="evidence-upload-grid full-span">
<% for(const [key,label] of Object.entries({proof_ftw:'Bukti FTW',proof_mine:'Bukti Mine Dispatch'})) { const current=row[key]?evidenceUrl(row[key]):''; %>
<div class="upload-field evidence-upload" data-evidence-upload data-current-url="<%= current %>" data-label="<%= label %>">
  <label for="<%= key %>"><%= label %></label><input id="<%= key %>" type="file" name="<%= key %>" accept="image/png,image/jpeg,image/webp" aria-describedby="<%= key %>-help <%= key %>-status" data-evidence-file>
  <small id="<%= key %>-help">PNG, JPG, WebP. Maksimal 5 MB. Klik preview untuk memperbesar.</small>
  <div class="upload-preview" data-evidence-preview <%= !current?'hidden':'' %>><% if(current) { %><a href="<%= current %>" data-lightbox aria-label="Perbesar <%= label %>"><img src="<%= current %>" alt="Preview <%= label %> yang tersimpan" loading="lazy"></a><% } %></div>
  <p class="upload-preview-status" id="<%= key %>-status" data-evidence-status role="status"><%= current?'Bukti tersimpan. Pilih gambar baru untuk menggantinya.':'Pilih gambar untuk melihat preview sebelum disimpan.' %></p>
  <button class="subtle-button" type="button" data-evidence-clear data-evidence-control hidden>Batalkan pilihan gambar</button>
  <% if(current) { %><label class="checkbox-label"><input type="checkbox" name="remove_<%= key %>" value="1" data-evidence-remove data-evidence-control>Hapus bukti tersimpan saat menyimpan</label><% } %>
</div><% } %></div></div>
<p class="fineprint">Gambar tidak otomatis mengubah status FTW atau Mine Dispatch.</p><div class="modal-actions"><a class="subtle-button" href="<%= url('lineup') %>">Batal</a><button class="btn primary" type="submit">Simpan Line Up</button></div></form>
<% if(row.id) { %><form class="delete-form" method="post" action="<%= url('lineup-delete') %>" data-confirm="Hapus Line Up ini dari database? Tindakan ini tidak dapat dibatalkan."><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="danger-button" type="submit">Hapus Line Up</button></form><% } %></section>
