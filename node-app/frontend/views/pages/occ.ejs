<%
const dash=occPage==='occ-dashboard',assetsPage=occPage==='occ-assets',cctvPage=occPage==='occ-cctv';
const categoryMap=[['audio','Audio',a=>a.category==='Audio'],['display','Display & monitor',a=>['Display','Monitor'].includes(a.category)],['workstation','Workstation',a=>a.category==='PC Workstation'],['camera','Kamera & CCTV',a=>['CCTV','Camera'].includes(a.category)],['control','Kontrol & aksesori',a=>!['Audio','Display','Monitor','PC Workstation','CCTV','Camera'].includes(a.category)]];
const categories=categoryMap.map(([id,name,match])=>({id,name,count:occAllAssets.filter(match).reduce((n,a)=>n+Number(a.qty||0),0),records:occAllAssets.filter(match).length}));
const pct=value=>value===null||value===undefined?'Belum dicek':new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(value)+'%';
const day=occSummary.work_date;
%>
<section class="occ-page"><div class="page-title"><div><h1><%= label %></h1><p>Jakarta Head Office · Operation Command Centre</p></div><div class="row-buttons"><a class="subtle-button" href="<%= url('occ-export',{...occFilters,kind:assetsPage||dash?'assets':cctvPage?'cctv':'availability'}) %>">Ekspor Excel</a><% if(canEditData) { %><a class="subtle-button" href="<%= url('occ-form',{kind:'cctv',work_date:day}) %>">Cek CCTV</a><a class="subtle-button" href="<%= url('occ-form',{kind:'availability',work_date:day}) %>">Cek perangkat</a><a class="btn primary" href="<%= url('occ-form',{kind:'asset'}) %>">Tambah aset OCC</a><% } %></div></div>
<nav class="occ-tabs" aria-label="Laporan OCC JHO"><% for(const [path,text] of [['occ-dashboard','Dashboard'],['occ-cctv','CCTV Availability'],['occ-availability','Inventory Availability'],['occ-assets','Inventory OCC']]) { %><a href="<%= url(path) %>" <%- occPage===path?'aria-current="page"':'' %>><%= text %></a><% } %></nav>
<form class="speed-filters occ-filters" method="get" action="<%= url(occPage) %>"><% if(!assetsPage) { %><label>Tanggal pemeriksaan<input type="date" name="work_date" value="<%= occFilters.work_date||'' %>"></label><% } else { %><label>Kategori<select name="group"><option value="">Semua kategori</option><% for(const c of categories) { %><option value="<%= c.id %>" <%= occFilters.group===c.id?'selected':'' %>><%= c.name %></option><% } %></select></label><% } %><label>Cari <%= assetsPage?'aset / kode / merek':'status / perangkat' %><input type="search" name="search" value="<%= occFilters.search %>" placeholder="<%= assetsPage?'Contoh: CC-OPT1':'Contoh: Issue' %>"></label><button class="subtle-button" type="submit">Tampilkan</button><a class="table-action" href="<%= url(occPage) %>">Reset</a><span class="occ-reference"><% if(assetsPage) { %>Master inventory OCC JHO<br><%= occSummary.asset_records %> baris · <%= occSummary.known_units %> unit fisik<% } else { %>Acuan <strong><%= dateId(day) %></strong><br>Pemeriksaan terakhir <%= dateId(occSummary.latest_checked_date) %><% } %></span></form>
<% if(dash) { %>
 <div class="kpi-grid occ-kpis"><article class="kpi orange"><span>Unit fisik terdata</span><strong><%= occSummary.known_units %></strong><small><%= occSummary.asset_records %> baris inventaris</small></article><article class="kpi green"><span>Baris aset tersedia</span><strong><%= occSummary.asset_available_records %><small> / <%= occSummary.asset_records %></small></strong><small>Ketersediaan pada master inventory</small></article><article class="kpi blue"><span>CCTV JHO</span><strong class="status-value"><%= occSummary.cctv_jho_status==='Not Checked'?'Belum dicek':occSummary.cctv_jho_status %></strong><small>Pemeriksaan <%= dateId(day,true) %></small></article><article class="kpi amber"><span>Perangkat telah dicek</span><strong><%= occSummary.daily_inventory.checked %><small> / <%= occSummary.daily_inventory.total %></small></strong><small><%= dateId(day,true) %> · <%= occSummary.daily_inventory.unchecked %> belum dicek</small></article></div>
 <section class="fleet-scene occ-room-scene" data-fleet-scene="occ" data-scene-style="pixel"><script type="application/json" data-scene-data><%- JSON.stringify({items:[],categories,date:day,total:occSummary.known_units,assets:occAllAssets.map(a=>({...a,group:categoryMap.find(([, ,match])=>match(a))?.[0]}))}).replace(/</g,'\\u003c') %></script><header class="fleet-heading"><div><h3>Ruang OCC Jakarta Head Office</h3><p>8 workstation di belakang meja rapat U. Ruang IT di kiri, Engineer di kanan, dipisahkan kaca. Klik objek untuk preview dan detail.</p></div><div class="scene-style-control"><button type="button" class="subtle-button" data-scene-style="pixel" aria-pressed="true">Pixel 3D</button><button type="button" class="subtle-button" data-scene-style="smooth" aria-pressed="false">3D halus</button></div></header><div class="occ-room-layout"><div><div class="fleet-viewport"><canvas role="img" aria-label="Ruang OCC 3D pixel dengan dinding video, meja operator, workstation dan kursi sesuai foto referensi"></canvas><div class="scene-labels"></div><p class="scene-fallback" hidden>Perangkat ini belum mendukung tampilan 3D. Gunakan daftar kategori untuk melihat seluruh aset.</p></div><div class="scene-controls"><span>Geser untuk memutar; klik objek untuk preview</span><div><button class="subtle-button" type="button" data-scene-reset>Atur ulang sudut</button></div></div></div><aside class="occ-room-index"><h4>Perangkat dalam ruang</h4><label class="sr-only" for="occ-object-picker">Pilih objek untuk preview</label><select id="occ-object-picker" class="occ-object-picker" data-occ-object-picker><option value="">Pilih objek untuk preview</option></select><% for(const c of categories) { %><a class="occ-category" data-occ-category="<%= c.id %>" href="<%= url('occ-assets',{group:c.id}) %>"><span><%= c.name %><small><%= c.records %> baris aset</small></span><strong><%= c.count %><small> unit</small></strong></a><% } %><a class="subtle-button occ-category-detail" data-occ-detail href="<%= url('occ-assets') %>">Buka inventory</a><p>Geometri dan posisi bersifat ilustratif. Jumlah berasal dari Inventory OCC; status harian ditampilkan terpisah.</p></aside></div></section>
 <section class="occ-team-panel"><div class="section-heading"><div><h3>Tim internship OCC JHO</h3><p>Nomor tempat duduk mengikuti susunan yang diberikan. Klik nama untuk preview karakter.</p></div></div><div class="occ-team-list" data-occ-team></div></section>
 <%- include('../occ-meetings') %>
 <div class="occ-status-layout"><section class="panel"><div class="section-heading"><div><h3>CCTV Availability</h3><p><%= dateId(day) %> · lima lokasi monitoring</p></div><a href="<%= url('occ-cctv',{work_date:day}) %>" class="table-action">Lihat riwayat</a></div><div class="occ-site-statuses"><% for(const site of OCC_CCTV_SITES) { const value=occSelectedCctv?.statuses?.[site]||'Not Checked'; %><div><b><%= site %></b><span class="occ-status <%= occStatusTone(value) %>"><%= value %></span></div><% } %></div></section><section class="panel"><div class="section-heading"><div><h3>Pengecekan perangkat</h3><p><%= dateId(day) %> · <%= occSummary.daily_inventory.total %> label perangkat</p></div><a href="<%= url('occ-availability',{work_date:day}) %>" class="table-action">Lihat perangkat</a></div><dl class="occ-check-summary"><div><dt>OK</dt><dd><%= occSummary.daily_inventory.ok %></dd></div><div><dt>Perlu tindak lanjut</dt><dd><%= occSummary.daily_inventory.issue %></dd></div><div><dt>Belum dicek</dt><dd><%= occSummary.daily_inventory.unchecked %></dd></div></dl><p class="fineprint">Not Checked tidak dihitung sebagai OK. Ketersediaan berdasarkan pemeriksaan: <%= pct(occSummary.daily_inventory.availability_percent) %>.</p></section></div>
 <div class="section-heading"><h3>Inventaris ruang OCC</h3><a class="table-action" href="<%= url('occ-assets') %>">Semua aset</a></div><%- include('../occ-assets-table',{occAssets:occAssets.slice(0,8)}) %>
<% } else if(assetsPage) { %><div class="section-heading"><h3><%= occAssets.length %> baris inventaris</h3><span><%= occSummary.known_units %> unit fisik pada seluruh master</span></div><%- include('../occ-assets-table') %>
<% } else {const checks=cctvPage?occCctv:occAvailability,keys=cctvPage?OCC_CCTV_SITES:OCC_ITEMS; %>
 <div class="section-heading"><h3><%= checks.length %> tanggal tercatat</h3><span>Status asli per <%= cctvPage?'lokasi':'label perangkat' %></span></div><div class="table-outer"><div class="table-scroll"><table class="data-table occ-history-table"><caption class="sr-only"><%= label %></caption><thead><tr><th>Tanggal</th><% for(const key of keys) { %><th><%= key %></th><% } %><th>Catatan</th><% if(canEditData) { %><th>Aksi</th><% } %></tr></thead><tbody><% for(const check of checks) { %><tr><td><strong><%= dateId(check.work_date,true) %></strong><small><%= check.work_date.slice(0,4) %></small></td><% for(const key of keys) {const value=check.statuses[key]||'Not Checked'; %><td><span class="occ-status <%= occStatusTone(value) %>"><%= value %></span></td><% } %><td><%= check.notes||'-' %></td><% if(canEditData) { %><td><a class="table-action" href="<%= url('occ-form',{kind:cctvPage?'cctv':'availability',work_date:check.work_date}) %>">Edit pemeriksaan</a></td><% } %></tr><% } %></tbody></table><% if(!checks.length) { %><div class="empty-state"><h3>Tidak ada pemeriksaan yang cocok</h3><p>Ubah tanggal atau kata pencarian. Tidak ada status yang diasumsikan OK.</p></div><% } %></div></div>
<% } %><p class="table-footnote">Sumber: <a href="<%= occSourceUrl %>" target="_blank" rel="noopener noreferrer">CCTV Availability, Inventory Availability, dan Inventory OCC</a>. Perubahan di aplikasi tersimpan di database dan tidak mengubah spreadsheet sumber.</p></section>
