<% if(user.must_change_password) { %><div class="alert" role="status">Anda masuk menggunakan password sementara dari administrator. Ganti password terlebih dahulu untuk melanjutkan pekerjaan.</div><% } %>
<% if(!user.must_change_password) { %>
<section class="editor-page"><div class="page-title"><div><h2>Edit profil</h2><p>Lengkapi foto, nama lengkap, NIK, dan site Anda.</p></div><span class="chip muted"><%= user.is_admin?'Administrator':ROLE %></span></div>
<form class="editor-form" method="post" action="<%= url('profile-save') %>" enctype="multipart/form-data" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><div class="profile-editor"><%- include('../profile-photo') %><div class="form-grid profile-identity">
<label>Nama lengkap<input name="name" autocomplete="name" required maxlength="120" value="<%= values.name || '' %>"></label><label>Username<input name="username" autocomplete="username" required minlength="3" maxlength="80" pattern="[a-zA-Z0-9_.\-]{3,80}" value="<%= values.username || '' %>"><small>Huruf, angka, titik, garis bawah, atau tanda hubung.</small></label>
<label>NIK<input name="nik" maxlength="60" value="<%= values.nik || '' %>" autocomplete="off"><small>Nomor induk karyawan, termasuk angka nol di depan.</small></label><label>Site<select name="site"><option value="">Belum diisi</option><%- include('../options',{values:SITES,selected:values.site}) %></select></label></div></div>
<div class="modal-actions"><a class="subtle-button" href="<%= url('lineup') %>">Kembali</a><button class="btn primary" type="submit">Simpan profil</button></div></form></section>
<% } %>
<section class="editor-page recovery-settings" aria-labelledby="password-title">
  <div class="page-title"><div><h2 id="password-title">Ganti password</h2><p>Setelah password diganti, semua perangkat keluar dan Anda perlu masuk kembali.</p></div></div>
  <form class="editor-form" method="post" action="<%= url('password-change') %>" data-saving>
    <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="username" autocomplete="username" value="<%= user.username %>">
    <div class="form-grid">
      <label class="full-span">Password saat ini<input name="current_password" type="password" required maxlength="128" autocomplete="current-password"><small><%= user.must_change_password?'Masukkan password sementara yang diberikan administrator.':'Konfirmasi password yang sedang Anda gunakan.' %></small></label>
      <label>Password baru<input name="password" type="password" required minlength="10" maxlength="72" autocomplete="new-password"><small>Minimal 10 karakter dan berbeda dari password saat ini.</small></label>
      <label>Ulangi password baru<input name="password_confirmation" type="password" required minlength="10" maxlength="72" autocomplete="new-password"></label>
    </div><div class="modal-actions"><button class="btn primary" type="submit">Simpan password baru</button></div>
  </form>
</section>
<% if(!user.must_change_password&&mailReady) { %>
<section class="editor-page recovery-settings" aria-labelledby="recovery-title">
  <div class="page-title"><div><h2 id="recovery-title">Email pemulihan</h2><p>Verifikasi email untuk menerima kode saat Anda lupa password.</p></div></div>
  <form class="editor-form" method="post" action="<%= url('recovery-email-save') %>">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <p><%= recoverySettings.email ? 'Email terverifikasi: '+recoverySettings.email : 'Belum ada email pemulihan yang diverifikasi.' %></p>
    <% if(!mailReady) { %><p class="muted">Pengiriman email menunggu konfigurasi pengelola. Setelah aktif, Anda bisa mendaftarkan alamat di sini.</p><% } %>
    <div class="form-grid"><label>Alamat email<input name="email" type="email" required maxlength="254" autocomplete="email" value="<%= recoverySettings.pending_email || recoverySettings.email || '' %>"></label><label>Password saat ini<input type="password" name="current_password" required maxlength="128" autocomplete="current-password"><small>Konfirmasi bahwa Anda pemilik akun ini.</small></label></div>
    <div class="modal-actions"><button class="btn primary" type="submit" <%= !mailReady?'disabled':'' %>>Kirim kode verifikasi</button></div>
  </form>
  <% if(recoverySettings.pending_email) { %>
  <form class="editor-form recovery-verification" method="post" action="<%= url('recovery-email-verify') %>">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <h3>Verifikasi email</h3><p>Kode dikirim ke <strong><%= recoverySettings.pending_email %></strong>. Berlaku 10 menit. Email sebelumnya tetap aktif sampai verifikasi selesai.</p>
    <div class="form-grid"><label>Kode dari email<input name="recovery_code" required maxlength="80" autocomplete="one-time-code" spellcheck="false"></label></div>
    <div class="modal-actions"><button class="btn primary" type="submit">Verifikasi email</button></div>
  </form>
  <% } %>
</section>
<% } else if(!user.must_change_password) { %>
<section class="editor-page recovery-settings" aria-labelledby="recovery-title"><h2 id="recovery-title">Bantuan saat lupa password</h2><p>Untuk sementara, hubungi administrator FleetSync untuk verifikasi identitas dan reset password.</p><% if(user.is_admin) { %><a class="auth-link" href="<%= url('accounts') %>">Reset password pengguna di Kelola Akun</a><% } %></section>
<% } %>
