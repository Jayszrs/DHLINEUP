<section class="editor-page"><div class="page-title"><div><h2>Profil saya</h2><p>Perbarui nama yang tampil dan username untuk masuk.</p></div><span class="chip muted"><%= ROLE %></span></div>
<form class="editor-form" method="post" action="<%= url('profile-save') %>" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><div class="form-grid">
<label>Nama lengkap<input name="name" autocomplete="name" required maxlength="120" value="<%= values.name || '' %>"></label><label>Username<input name="username" autocomplete="username" required minlength="3" maxlength="80" pattern="[a-zA-Z0-9_.\-]{3,80}" value="<%= values.username || '' %>"><small>Huruf, angka, titik, garis bawah, atau tanda hubung.</small></label></div>
<div class="modal-actions"><a class="subtle-button" href="<%= url('lineup') %>">Kembali</a><button class="btn primary" type="submit">Simpan profil</button></div></form></section>
