<section class="panel form-panel"><div class="page-title"><div><h1><%= row.id?'Edit meeting OCC':'Jadwalkan meeting OCC' %></h1><p>Waktu Jakarta (WIB). Jadwal yang bertabrakan tidak dapat disimpan.</p></div><a class="subtle-button" href="<%= url('occ-dashboard',{meeting_date:(row.start_at||'').slice(0,10)}) %>">Kembali</a></div>
<form method="post" action="<%= url('occ-meeting-save') %>" class="editor-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id||'' %>"><input type="hidden" name="version" value="<%= row.version||0 %>"><div class="form-grid"><label class="full">Judul meeting<input name="title" maxlength="180" value="<%= row.title||'' %>" required></label><label>Mulai (WIB)<input type="datetime-local" name="start_at" value="<%= row.start_at||'' %>" required></label><label>Selesai (WIB)<input type="datetime-local" name="end_at" value="<%= row.end_at||'' %>" required></label><label class="full">Link meeting<input type="url" name="meeting_url" maxlength="2048" placeholder="https://…" value="<%= row.meeting_url||'' %>"><small>Opsional; gunakan link HTTPS dari layanan meeting.</small></label><label class="full">Catatan<textarea name="notes" maxlength="10000" rows="3"><%= row.notes||'' %></textarea></label></div><button type="submit" class="btn primary">Simpan jadwal</button></form>
<% if(row.id){ %><details class="meeting-delete"><summary>Hapus jadwal ini</summary><p>Meeting ini akan dihapus dari jadwal ruang OCC.</p><form method="post" action="<%= url('occ-meeting-delete') %>"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><button type="submit" class="subtle-button">Hapus meeting</button></form></details><% } %></section>
