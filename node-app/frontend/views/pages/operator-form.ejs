<section class="editor-page"><div class="page-title"><div><h2><%= !canEditData?'Profil':row.id?'Edit':'Tambah' %> Operator</h2><p>Perubahan profil tidak mengubah identitas pada riwayat Line Up sebelumnya.</p></div><a class="subtle-button" href="<%= url('master') %>">Kembali</a></div>
<% if(!canEditData) { %><div class="identity-grid"><% for(const [key,label] of Object.entries({name:'NAMA OPERATOR',nik:'NIK',unit:'UNIT TERAKHIR',equipment:'JENIS ALAT',site:'DISTRICT'})) { %><div><small><%= label %></small><strong><%= row[key] || '-' %></strong></div><% } %><div><small>TANGGAL TERAKHIR</small><strong><%= dateId(row.last_date) %></strong></div></div><% } else { %>
<form class="editor-form" method="post" action="<%= url('operator-save') %>" data-saving><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><div class="form-grid">
<label>District<select name="site"><%- include('../options',{values:SITES,selected:row.site}) %></select></label><label>Tanggal terakhir<input type="date" name="last_date" value="<%= row.last_date || '' %>"></label>
<% for(const [key,label,max] of [['name','Nama Operator *',150],['nik','NIK *',60],['unit','Unit Terakhir',60],['equipment','Jenis Alat',100]]) { %><label><%= label %><input name="<%= key %>" maxlength="<%= max %>" value="<%= row[key] || '' %>" <%= ['name','nik'].includes(key)?'required':'' %>></label><% } %></div><div class="modal-actions"><a class="subtle-button" href="<%= url('master') %>">Batal</a><button class="btn primary" type="submit">Simpan Operator</button></div></form>
<% if(row.id) { %><form class="delete-form" method="post" action="<%= url('operator-delete') %>" data-confirm="Hapus profil operator ini? Riwayat Line Up tetap disimpan. Tindakan ini menghapus profil dari daftar Operator."><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="danger-button" type="submit">Hapus Operator</button></form><% } %><% } %></section>
