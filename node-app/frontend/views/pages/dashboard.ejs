<%
const total=rows.length,yes=(items,key)=>items.filter(r=>r[key]==='Ya').length;
const reference=rows.length?rows.map(r=>r.work_date).sort().at(-1):new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'});
const end=new Date(reference+'T00:00:00Z'),weekDate=new Date(end);weekDate.setUTCDate(end.getUTCDate()-((end.getUTCDay()+6)%7));const week=weekDate.toISOString().slice(0,10);
const periods=[['DAILY',dateId(reference,true),rows.filter(r=>r.work_date===reference)],['WTD',dateId(week,true)+' - '+dateId(reference,true),rows.filter(r=>r.work_date>=week&&r.work_date<=reference)],['MTD',reference.slice(5,7)+'/'+reference.slice(0,4),rows.filter(r=>r.work_date.slice(0,7)===reference.slice(0,7))],['YTD',reference.slice(0,4),rows.filter(r=>r.work_date.slice(0,4)===reference.slice(0,4))]];
const daily=Array.from({length:8},(_,i)=>{const day=new Date(end.valueOf()-(7-i)*86400000).toISOString().slice(0,10);return [day,rows.filter(r=>r.work_date===day).length];}),max=Math.max(1,...daily.map(d=>d[1]));
const counts={'SESUAI':0,'BELUM DICEK':0,'TINDAK LANJUT':0};for(const row of rows) counts[status(row)[0]]++;
const noDriver=rows.filter(r=>r.dh!=='Ya').length;
%>
<section><div class="page-title dashboard-title"><div><h2>Dashboard operasional</h2><p>Monitoring Line Up, Mine Dispatch, dan FTW · <%= filters.site %></p></div><a class="btn primary" href="<%= url('lineup',{site:filters.site}) %>">Lihat Line Up &rsaquo;</a></div>
<form class="dashboard-filter" method="get" action="<%= url('dashboard') %>"><label class="site-filter">District<select name="site"><%- include('../options',{values:SITES,selected:filters.site}) %></select></label><button class="subtle-button" type="submit">Tampilkan</button><span class="muted"><%= rows.length?'Acuan periode: data terakhir '+dateId(reference):'Belum ada catatan pada district ini.' %></span></form>
<div class="kpi-grid"><% for(const [name,n,help,tone] of [['TOTAL LINE UP',total,'Seluruh catatan district','orange'],['MINE TERDETEKSI',yes(rows,'mine'),(total?Math.round(yes(rows,'mine')/total*100):0)+'% dari total','green'],['BELUM DI MINE',rows.filter(r=>r.mine==='Tidak').length,'Status Mine: Tidak','red'],['FTW TERISI',yes(rows,'ftw'),(total-yes(rows,'ftw'))+' belum terkonfirmasi Ya','amber']]) { %><article class="kpi <%= tone %>"><span><%= name %></span><strong><%= n %></strong><small><%= help %></small></article><% } %></div>
<%- include('../fleet-scene',{sceneKind:'lineup',pace:total?counts['SESUAI']/total*100:0,sceneTitle:'Kesiapan operator',sceneDescription:!total?'Belum ada penugasan pada district ini.':noDriver?noDriver+' penugasan belum terkonfirmasi terdata di DHOCC.':'Seluruh penugasan terkonfirmasi terdata di DHOCC.',sceneValue:total?Math.round(counts['SESUAI']/total*100)+'%':'Belum ada data',sceneValueLabel:'penugasan terdata di DHOCC, Mine Dispatch dan FTW terkonfirmasi'}) %>
<div class="section-title"><strong>RINGKASAN PERIODE</strong><small>Jumlah penugasan, bukan jam produksi.</small></div><div class="period-grid"><% for(const [name,period,items] of periods) { const minePercent=items.length?Math.round(yes(items,'mine')/items.length*100):null,ftwPercent=items.length?Math.round(yes(items,'ftw')/items.length*100):null; %><article class="period period-<%= name.toLowerCase() %>"><div class="period-head"><%= name %><span><%= period %></span></div><div class="period-body"><strong><%= items.length %> entri</strong><div class="period-measures"><% for(const [label,value,key] of [['Mine',minePercent,'mine'],['FTW',ftwPercent,'ftw']]) { %><div class="ring-measure"><div class="percent-ring <%= key==='ftw'?'ring-ftw':'' %>" style="--percent:<%= value??0 %>"><b><%= value===null?'N/A':value+'%' %></b><small><%= label %></small></div><span><%= yes(items,key) %>/<%= items.length %></span></div><% } %></div></div></article><% } %></div>
<div class="dashboard-lower"><div class="panel trend-panel"><h3>Tren Line Up harian</h3><p>8 hari sampai tanggal data terakhir. Pilih batang untuk melihat catatan.</p><div class="trend-bars"><% for(const [day,count] of daily) { %><a class="trend-item" href="<%= url('lineup',{site:filters.site,work_date:day}) %>" aria-label="<%= dateId(day)+': '+count+' entri' %>"><b><%= count %></b><div class="trend-track"><div class="<%= day===reference?'highlight':'' %>" style="height:<%= count/max*100 %>%"></div></div><span><%= day.slice(-2) %></span></a><% } %></div></div><div class="panel site-panel"><h3>Hasil pengecekan</h3><% for(const [label,count] of Object.entries(counts)) { %><div class="site-row"><strong><%= label %></strong><span><%= count %> entri</span></div><% } %><p>Mine dan FTW harus sama-sama Ya untuk hasil SESUAI.</p></div></div>
<div class="attention-panel"><div><b>Prioritas pengecekan</b><span>FTW / Mine belum sesuai</span></div><div><% const needs=rows.filter(r=>status(r)[0]!=='SESUAI').slice(0,3);for(const row of needs) { %><a class="subtle-button" href="<%= url('detail',{id:row.id}) %>"><%= row.unit %> &rsaquo;</a><% } if(!needs.length) { %><span><%= rows.length?'Seluruh catatan sudah sesuai.':'Belum ada Line Up di district ini.' %></span><% } %></div></div><p class="fineprint">Dashboard dihitung dari database saat halaman dibuka. Status FTW dan Mine Dispatch dinilai terpisah.</p></section>
