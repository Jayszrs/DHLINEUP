<%
const total=rows.length,yes=(items,key)=>items.filter(r=>r[key]==='Ya').length;
const shiftTitle={D:'Day Shift',N:'Night Shift',All:'Semua shift','Belum ditentukan':'Shift belum ditentukan'}[filters.shift];
const reference=filters.work_date||(historyRows.length?historyRows.map(r=>r.work_date).sort().at(-1):new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}));
const periodRows=historyRows.filter(r=>r.work_date<=reference);
const end=new Date(reference+'T00:00:00Z'),weekDate=new Date(end);weekDate.setUTCDate(end.getUTCDate()-((end.getUTCDay()+6)%7));const week=weekDate.toISOString().slice(0,10);
const periods=[['DAILY',dateId(reference,true),periodRows.filter(r=>r.work_date===reference)],['WTD',dateId(week,true)+' - '+dateId(reference,true),periodRows.filter(r=>r.work_date>=week&&r.work_date<=reference)],['MTD',reference.slice(5,7)+'/'+reference.slice(0,4),periodRows.filter(r=>r.work_date.slice(0,7)===reference.slice(0,7))],['YTD',reference.slice(0,4),periodRows.filter(r=>r.work_date.slice(0,4)===reference.slice(0,4))]];
const daily=Array.from({length:8},(_,i)=>{const day=new Date(end.valueOf()-(7-i)*86400000).toISOString().slice(0,10);return [day,periodRows.filter(r=>r.work_date===day).length];}),max=Math.max(1,...daily.map(d=>d[1]));
const counts={'SESUAI':0,'BELUM DICEK':0,'TINDAK LANJUT':0};for(const row of rows) counts[status(row)[0]]++;
const noDriver=rows.filter(r=>r.dh!=='Ya').length;
%>
<section><div class="page-title dashboard-title"><div><h2>Dashboard operasional</h2><p>Monitoring Line Up, Mine Dispatch, dan FTW · <%= filters.site %> · <%= shiftTitle %></p></div><a class="btn primary" href="<%= url('lineup',{site:filters.site,work_date:filters.work_date,shift:filters.shift}) %>">Lihat Line Up &rsaquo;</a></div>
<form class="dashboard-filter" method="get" action="<%= url('dashboard') %>"><label class="site-filter">District<select name="site"><%- include('../options',{values:SITES,selected:filters.site}) %></select></label><label>Shift<select name="shift"><%- include('../options',{values:{All:'Semua shift',D:'Day Shift',N:'Night Shift','Belum ditentukan':'Belum ditentukan'},selected:filters.shift}) %></select></label><label>Tanggal laporan<input type="date" name="work_date" value="<%= filters.work_date %>"></label><button class="subtle-button" type="submit">Tampilkan</button><a class="subtle-button" href="<%= url('dashboard',{site:filters.site,shift:filters.shift}) %>">Semua tanggal</a><span class="muted"><%= filters.work_date?'Laporan tanggal '+dateId(reference):historyRows.length?'Semua tanggal · ringkasan periode sampai '+dateId(reference):'Belum ada data di district ini.' %></span></form>
<% if(!rows.length&&filters.shift==='N') { %><div class="panel night-shift-empty"><h3>Belum ada data Night Shift<%= filters.work_date?' pada tanggal ini':'' %></h3><p>Data Day Shift ditampilkan terpisah. Tambahkan penugasan Night Shift dengan tanggal dan operator yang sesuai.</p><% if(canEditData) { %><a class="btn primary" href="<%= url('lineup-form',{site:filters.site,shift:'N',work_date:filters.work_date||reference}) %>">Input Night Shift</a><a class="subtle-button" href="<%= url('import',{shift:'N'}) %>">Impor Night Shift</a><% } %></div><% } %><div class="kpi-grid"><% for(const [name,n,help,tone] of [['Total penugasan',total,filters.work_date?'Penugasan pada tanggal pilihan':'Penugasan dari semua tanggal','orange'],['Terdata di Mine Dispatch',yes(rows,'mine'),(total?Math.round(yes(rows,'mine')/total*100):0)+'% dari total','green'],['Belum terdata di Mine Dispatch',rows.filter(r=>r.mine==='Tidak').length,'Status Mine Dispatch: Tidak','red'],['FTW terisi',yes(rows,'ftw'),(total-yes(rows,'ftw'))+' penugasan belum dikonfirmasi','amber']]) { %><article class="kpi <%= tone %>"><span><%= name %></span><strong><%= n %></strong><small><%= help %></small></article><% } %></div>
<%- include('../fleet-scene',{sceneKind:'lineup',sceneData:lineupSceneData,sceneAction:url('dashboard'),sceneFilters:{site:filters.site,shift:filters.shift}}) %>
<%- include('../lineup-periods',{periods,yes}) %>
<div class="dashboard-lower"><%- include('../analytics-chart',{chart:{title:'Tren Line Up harian',note:'Delapan hari sampai tanggal laporan · jumlah penugasan',unit:' penugasan',series:[{name:'Penugasan',color:'#d3741c',data:daily.map(([x,y])=>({x,y,href:url('lineup',{site:filters.site,work_date:x,shift:filters.shift})}))}]}}) %><div class="panel site-panel"><h3>Hasil pengecekan</h3><% for(const [label,count] of Object.entries(counts)) { %><div class="site-row"><strong><%= label %></strong><span><%= count %> entri · <%= total?Math.round(count/total*100):0 %>%</span><div class="chart-status-meter"><span style="width:<%= total?count/total*100:0 %>%"></span></div></div><% } %><p>Status Mine Dispatch dan FTW harus sama-sama Ya agar penugasan dinyatakan sesuai.</p></div></div>
<div class="attention-panel"><div><b>Prioritas pengecekan</b><span>Mine Dispatch atau FTW belum lengkap</span></div><div><% const needs=rows.filter(r=>status(r)[0]!=='SESUAI').slice(0,3);for(const row of needs) { %><a class="subtle-button" href="<%= url('detail',{id:row.id}) %>"><%= row.unit %> &rsaquo;</a><% } if(!needs.length) { %><span><%= rows.length?'Seluruh catatan sudah sesuai.':'Belum ada Line Up di district ini.' %></span><% } %></div></div><p class="fineprint">Dashboard dihitung dari database saat halaman dibuka. Status FTW dan Mine Dispatch dinilai terpisah.</p></section>
