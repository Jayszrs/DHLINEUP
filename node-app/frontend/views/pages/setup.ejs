<h1>Buat akun pertama</h1><p class="muted">Database siap. Buat akun Pengelola untuk mulai memakai DHOCC.</p>
<form method="post" action="<%= url('setup') %>" class="auth-form"><input type="hidden" name="csrf" value="<%= csrf %>">
<% if(activationRequired) { %><label>Kode aktivasi hosting<input type="password" name="activation_code" required maxlength="128" autocomplete="off"><small>Gunakan kode aktivasi pemilik hosting.</small></label><% } %>
<label>Nama pengelola<input name="name" required maxlength="120" autocomplete="name" value="<%= values.name || '' %>"></label>
<label>Username<input name="username" required minlength="3" maxlength="80" pattern="[a-zA-Z0-9_.\-]{3,80}" autocomplete="username" value="<%= values.username || '' %>"></label>
<label>Password<input type="password" name="password" required minlength="10" maxlength="72" autocomplete="new-password"><small>Minimal 10 karakter.</small></label>
<label>Ulangi password<input type="password" name="password_confirmation" required minlength="10" maxlength="72" autocomplete="new-password"></label>
<button class="btn primary" type="submit">Buat akun &amp; masuk</button></form><p class="fineprint">Setup ditutup setelah akun pertama dibuat.</p>
