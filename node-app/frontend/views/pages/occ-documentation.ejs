<section class="occ-documentation"><div class="page-title"><div><h1>Dokumentasi <%= occAsset.name %></h1><p class="occ-asset-codes"><%= occAsset.asset_code||'OCC JHO' %> · <%= occAsset.placement||'Ruang OCC' %></p></div><div class="page-actions"><% if(canEditData){ %><a class="btn primary" href="<%= url('occ-form',{kind:'asset',id:occAsset.id}) %>">Tambah foto</a><% } %><a class="subtle-button" href="<%= url('occ-assets') %>#asset-<%= occAsset.id %>">Kembali ke aset</a></div></div>
<% if(occPictures.length) { %><p class="fineprint">Foto asli dokumentasi OCC. Klik foto untuk memperbesar.</p><div class="occ-photo-gallery"><% for(const [index,photo]of occPictures.entries()){ %><figure><a href="<%= url('occ-photo',{id:occAsset.id,index}) %>" data-lightbox><img src="<%= url('occ-photo',{id:occAsset.id,index}) %>" alt="<%= photo.name %>" loading="lazy" width="960" height="720"></a><figcaption><%= photo.name %></figcaption></figure><% } %></div><% } else { %><div class="empty-state"><h3>Foto dokumentasi belum tersedia</h3><p>Aset ini belum memiliki foto yang tersimpan di website.</p></div><% } %></section>
