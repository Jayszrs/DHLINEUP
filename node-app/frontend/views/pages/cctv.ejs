<% const number=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(n),colors=['#ce7416','#226fa6','#16805d','#73529b','#167c89','#b83a4b']; %>
<section class="occ-page"><div class="page-title"><div><h1>CCTV Availability</h1><p>Enam site · pantau kamera bermasalah, durasi offline, dan bukti per tanggal</p></div><div class="row-buttons"><a class="subtle-button" href="<%= url('cctv-export',filters) %>">Ekspor Excel</a><% if(canEditData){ %><a class="btn primary" href="<%= url('cctv-report-form',{site:filters.site||'HO',work_date:reference}) %>">Input laporan CCTV</a><% } %></div></div>
<nav class="occ-tabs" aria-label="Laporan OCC"><a href="/occ-dashboard">Dashboard JHO</a><a href="/occ-cctv" aria-current="page">CCTV Availability</a><a href="/occ-availability">Inventory Availability</a><a href="/occ-assets">Inventory OCC</a></nav>
<form class="speed-filters" method="get"><label>Dari tanggal<input type="date" name="from" value="<%= filters.from %>"></label><label>Sampai tanggal<input type="date" name="to" value="<%= filters.to %>"></label><label>Site<select name="site"><option value="">Semua site</option><% for(const site of CCTV_SITES){ %><option value="<%= site %>" <%= filters.site===site?'selected':'' %>><%= site==='HO'?'HO / JHO':site %></option><% } %></select></label><label>Cari CCTV / catatan<input type="search" name="search" value="<%= filters.search %>" placeholder="Contoh: PIT-C"></label><button class="subtle-button">Terapkan</button><a class="table-action" href="/occ-cctv">Reset</a></form>
<div class="section-heading"><div><h3>Ringkasan tanggal <%= dateId(reference) %></h3><p><%= filters.site||'Seluruh site' %> · tanggal terakhir terdata dalam rentang pilihan</p></div><span class="occ-status <%= summary.availability===null?'muted':summary.availability<60?'red':'green' %>"><%= summary.availability===null?'Belum terdata':summary.availability<60?'Kurang baik · di bawah 60%':'Memadai · 60% atau lebih' %></span></div>
<div class="cctv-kpis"><% for(const [label,value,tone,help]of[['Total CCTV',summary.total,'blue','Jumlah kamera pada tanggal ringkasan'],['CCTV down',summary.down,'red','Kamera bermasalah pada laporan'],['CCTV ON',summary.online,'green','Kamera tersedia'],['Availability',summary.availability===null?'—':(filters.site?cctvPercent(latest.find(r=>r.site===filters.site)):number(summary.availability)+'%'),summary.availability<60?'red':'green','CCTV ON ÷ total CCTV × 100%']]){ %><article class="cctv-metric <%= tone %>"><span><%= label %></span><strong><%= summary.total?value:'—' %></strong><small><%= help %></small></article><% } %></div>
<div class="section-heading"><div><h3>Ketersediaan setiap site</h3><p>Tren <%= dateId(filters.from,true) %>–<%= dateId(filters.to,true) %>. Garis putus-putus menunjukkan batas 60%.</p></div><span>Ringkasan periode: <%= period.availability===null?'Belum terdata':number(period.availability)+'%' %></span></div>
<div class="analytics-grid cctv-sites-grid"><% for(const[sidx,item]of sites.entries()){const r=item.row; %><section class="cctv-site"><div class="cctv-site-head"><div><h3><%= item.site==='HO'?'HO / JHO':item.site %></h3><small><%= dateId(reference,true) %></small></div><strong class="<%= r&&r.availability_percent<60?'danger-text':'' %>"><%= cctvPercent(r) %></strong></div><div class="cctv-site-counts"><span><b><%= r?r.online_count:'—' %></b> ON</span><span><b><%= r?r.down_count:'—' %></b> down</span><span><b><%= r?r.total_count:'—' %></b> total</span></div><%- include('../analytics-chart',{chart:{title:'Availability '+item.site,unit:'%',min:0,max:100,threshold:60,from:filters.from,to:filters.to,series:[{name:'Availability',color:colors[sidx],data:item.series.map(r=>({x:r.work_date,y:r.availability_percent,display:cctvPercent(r),detail:r.online_count+'/'+r.total_count+' ON · '+r.down_count+' down'}))}]}}) %><a class="table-action" href="<%= url('occ-cctv',{...filters,site:item.site}) %>#cctv-history">Lihat rincian <%= item.site %></a></section><% } %></div>
<div class="section-heading" id="cctv-history"><div><h3>Riwayat laporan harian</h3><p><%= history.length %> laporan site/tanggal · jumlah dan catatan sumber dipertahankan</p></div></div>
<div class="table-outer"><div class="table-scroll"><table class="data-table cctv-history"><thead><tr><th>Tanggal / site</th><th>Total</th><th>Down</th><th>ON</th><th>Availability</th><th>CCTV / durasi / bukti</th><th>Catatan</th><% if(canEditData){ %><th>Aksi</th><% } %></tr></thead><tbody><% for(const r of [...history].reverse()){ %><tr data-report-site="<%= r.site %>" data-report-date="<%= r.work_date %>"><td><strong><%= dateId(r.work_date,true) %></strong><small><%= r.site %> · <%= r.work_date.slice(0,4) %></small></td><td><%= r.total_count %></td><td><strong><%= r.down_count %></strong></td><td><%= r.online_count %></td><td><span class="occ-status <%= r.availability_percent<60?'red':'green' %>"><%= cctvPercent(r) %></span></td><td><details><summary><%= r.incidents.length %> nama · <%= r.incidents.reduce((n,i)=>n+(i.media||[]).length,0) %> bukti</summary><div class="cctv-incidents"><% for(const incident of r.incidents){ %><article class="cctv-incident"><strong><%= incident.name %></strong><span><%= incident.duration_minutes===null?'Durasi belum diisi':Math.floor(incident.duration_minutes/60)+' jam '+incident.duration_minutes%60+' menit offline' %></span><div class="cctv-media"><% for(const media of incident.media||[]){const href=url('cctv-media',{site:r.site,work_date:r.work_date,id:media.id}); %><% if(media.mime.startsWith('video/')){ %><video controls preload="none" src="<%= href %>" aria-label="Bukti offline <%= incident.name %>"></video><% }else{ %><a href="<%= href %>" data-lightbox><img loading="lazy" src="<%= href %>" alt="Bukti offline <%= incident.name %>"></a><% } %><% } %></div></article><% } %><% if(!r.incidents.length){ %><p>Nama CCTV belum dirinci pada sumber.</p><% } %></div></details><% if(r.source_flags.length){ %><small class="cctv-warning"><%= r.source_flags.includes('names_differ')?'Nama pada catatan berbeda dengan jumlah down sumber.':'Nama CCTV belum lengkap pada sumber.' %> Angka sumber tetap dipertahankan.</small><% } %></td><td class="source-notes"><%= r.remarks||'—' %></td><% if(canEditData){ %><td><a class="table-action" href="<%= url('cctv-report-form',{site:r.site,work_date:r.work_date}) %>">Edit / tambah bukti</a></td><% } %></tr><% } %></tbody></table><% if(!history.length){ %><div class="empty-state"><h3>Belum ada laporan pada pilihan ini</h3><p>Ubah tanggal atau site, atau tambahkan pemeriksaan.</p></div><% } %></div></div><p class="table-footnote">Sumber riwayat: <a href="<%= cctvSourceUrl %>" target="_blank" rel="noopener noreferrer">Sheet1 · CCTV Availability All Site</a>. Data sejak 31 Juli 2026. Durasi dan bukti yang belum tersedia tidak dibuat otomatis. Perubahan di website tersimpan terpisah dari spreadsheet.</p></section>
