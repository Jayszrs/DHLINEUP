<section class="fleet-scene fleet-explorer" data-fleet-scene="<%= sceneKind %>">
 <script type="application/json" data-scene-data><%- JSON.stringify(sceneData).replace(/</g,'\\u003c') %></script>
 <header class="fleet-heading"><div><h3><%= sceneKind==='speed'?'Fleet speed per tanggal':'Tindak lanjut driver per tanggal' %></h3><p><%= sceneKind==='speed'?'Setiap DT memakai rata-rata speed dari catatan pada tanggal pilihan.':'Nama, unit, dan status penugasan yang belum lengkap atau belum terkonfirmasi.' %></p></div>
 <form method="get" action="<%= sceneAction %>" class="scene-date-form"><% for(const [key,value] of Object.entries(sceneFilters)) { if(value) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }} %><label>Tanggal laporan<input type="date" name="<%= sceneKind==='lineup'?'work_date':'scene_date' %>" value="<%= sceneData.date %>" required></label><button type="submit" class="subtle-button">Tampilkan</button></form></header>
 <div class="fleet-summary-strip"><strong><%= sceneData.items.length %> <%= sceneKind==='speed'?'DT berdata':'unit perlu ditindaklanjuti' %></strong><span><%= dateId(sceneData.date) %></span><span><%= sceneKind==='speed'?'Label: rata-rata semua · km/jam':sceneData.driverCount+' nama driver · '+sceneData.total+' penugasan pada tanggal ini' %></span></div>
 <div class="fleet-workbench"><div class="fleet-visual-area"><div class="fleet-viewport"><canvas role="img" aria-label="<%= sceneKind==='speed'?'Fleet dump truck 3D dengan label unit dan rata-rata kecepatan':'Driver 3D dengan nama, DT, dan status yang perlu dilengkapi' %>"></canvas><div class="scene-labels"></div><p class="scene-fallback" hidden>3D belum tersedia di perangkat ini. Seluruh data dapat dibuka melalui daftar di samping.</p><% if(!sceneData.items.length) { %><div class="scene-empty"><h4><%= sceneData.total?'Semua penugasan pada tanggal ini sudah lengkap':'Tidak ada catatan pada tanggal ini' %></h4><p><%= sceneKind==='speed'?'Pilih tanggal lain yang memiliki rekap speed.':'Daftar driver hanya muncul dari penugasan yang benar-benar tersimpan.' %></p></div><% } %></div>
 <div class="scene-controls"><div class="scene-pagination"><button type="button" class="subtle-button" data-scene-page-prev aria-label="Fleet sebelumnya">Sebelumnya</button><span data-scene-page-label aria-live="polite"></span><button type="button" class="subtle-button" data-scene-page-next aria-label="Fleet berikutnya">Berikutnya</button></div><div><button class="subtle-button" data-scene-reset type="button">Atur ulang sudut</button></div></div>
 <p class="scene-note">Geser untuk mengubah sudut. Pilih label atau baris DT untuk melihat detail. Visualisasi rekap harian, bukan posisi GPS langsung.</p></div>
 <aside class="fleet-manifest"><label class="scene-search-label">Cari <%= sceneKind==='speed'?'DT':'nama / DT / status' %><input type="search" data-scene-search placeholder="<%= sceneKind==='speed'?'Contoh: DT2684':'Cari driver atau nomor DT' %>"></label><div class="scene-records"><% for(const item of sceneData.items) { %><a href="<%= item.href %>" class="scene-record" data-scene-focus="<%= item.id %>"><div><strong><%= item.unit %></strong><% if(sceneKind==='speed') { %><b><%= speedNumber(item.average) %> <small>km/jam</small></b><% } %></div><% if(sceneKind==='speed') { %><span>Bergerak <%= speedNumber(item.moving_average) %> · Maks. <%= speedNumber(item.max_speed) %></span><small><%= speedNumber(item.count,0) %> catatan GPS</small><% } else { %><span><%= item.name %></span><small><%= item.missing.join(' · ') %></small><% } %></a><% } %></div><p class="scene-search-empty" hidden>Tidak ada hasil yang cocok.</p><a class="scene-detail-link subtle-button" data-scene-detail href="<%= sceneData.items[0]?.href||sceneAction %>"><%= sceneKind==='speed'?'Buka laporan DT':'Buka detail penugasan' %></a></aside></div>
</section>
<%- include('studio-credits') %>
