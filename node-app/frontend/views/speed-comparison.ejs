<% const compared=speedUnits.filter(r=>r.total_count>0),ceiling=Math.max(5,Math.ceil(Math.max(0,...compared.map(r=>Math.max(r.average||0,r.moving_average||0)))/5)*5); %>
<section class="speed-chart speed-comparison" aria-labelledby="speed-comparison-title">
  <div class="section-heading"><div><h3 id="speed-comparison-title">Perbandingan speed semua unit DT berdata</h3><p><%= compared.length %> unit · Rata-rata berbobot pada periode yang dipilih</p></div><a class="table-action" href="<%= url('speed-units',speedFilters) %>">Lihat angka per unit</a></div>
  <div class="comparison-toolbar"><div class="comparison-legend"><span><i class="comparison-key all"></i>Rata-rata semua</span><span><i class="comparison-key moving"></i>Rata-rata bergerak</span></div><div class="comparison-switch" role="group" aria-label="Ukuran grafik perbandingan"><button type="button" data-comparison-mode="overview" aria-pressed="true" <%= compared.length?'':'disabled' %>>Semua unit</button><button type="button" data-comparison-mode="detail" aria-pressed="false" <%= compared.length?'':'disabled' %>>Perbesar</button></div></div>
  <% if(compared.length) { %><% for(const mode of ['overview','detail']) {const width=mode==='detail'?Math.max(1080,compared.length*27+88):1080,left=58,right=22,top=22,bottom=252,height=338,step=(width-left-right)/compared.length,bar=Math.min(9,Math.max(1,step*.34)),interval=mode==='detail'?1:Math.max(1,Math.ceil(compared.length/30)); %>
  <div class="comparison-viewport" data-comparison-view="<%= mode %>" <%= mode==='detail'?'hidden':'' %> tabindex="0" role="region" aria-label="Grafik speed <%= mode==='detail'?'diperbesar, dapat digulir mendatar':'semua unit' %>">
    <svg class="comparison-svg <%= mode==='detail'?'comparison-detail':'' %>" viewBox="0 0 <%= width %> <%= height %>" <%- mode==='detail'?`style="width:${width}px"`:'' %> role="img" aria-labelledby="comparison-<%= mode %>-title comparison-<%= mode %>-desc">
      <title id="comparison-<%= mode %>-title">Perbandingan rata-rata speed <%= compared.length %> unit DT</title><desc id="comparison-<%= mode %>-desc">Speed dalam kilometer per jam. Biru adalah rata-rata seluruh catatan, merah adalah rata-rata catatan bergerak. Angka rinci tersedia melalui tautan Lihat angka per unit.</desc>
      <% for(let i=0;i<=5;i++){const y=bottom-i*(bottom-top)/5; %><line class="chart-grid" x1="<%= left %>" y1="<%= y %>" x2="<%= width-right %>" y2="<%= y %>"/><text class="comparison-axis" x="<%= left-10 %>" y="<%= y+4 %>" text-anchor="end"><%= speedNumber(ceiling*i/5,1) %></text><% } %>
      <% for(const [i,r] of compared.entries()){const x=left+i*step,center=x+step/2,averageHeight=(r.average||0)*(bottom-top)/ceiling,movingHeight=(r.moving_average||0)*(bottom-top)/ceiling; %>
      <a href="<%= url('speed-unit',{...speedFilters,unit:r.unit}) %>" tabindex="-1" aria-label="Laporan <%= r.unit %>"><title><%= r.unit %> — Semua: <%= speedNumber(r.average) %> km/jam; bergerak: <%= speedNumber(r.moving_average) %> km/jam</title><rect x="<%= x %>" y="<%= top %>" width="<%= step %>" height="<%= bottom-top %>" fill="transparent"/><rect class="comparison-bar all" x="<%= center-bar-0.5 %>" y="<%= bottom-averageHeight %>" width="<%= bar %>" height="<%= averageHeight %>"/><rect class="comparison-bar moving" x="<%= center+0.5 %>" y="<%= bottom-movingHeight %>" width="<%= bar %>" height="<%= movingHeight %>"/>
      <% if((i%interval===0&&i<compared.length-1-Math.floor(interval/2))||i===compared.length-1){ %><text class="comparison-unit" x="<%= center %>" y="<%= bottom+12 %>" text-anchor="end" transform="rotate(-90 <%= center %> <%= bottom+12 %>)"><%= r.unit %></text><% } %></a><% } %>
      <text class="comparison-axis" x="<%= width/2 %>" y="329" text-anchor="middle">Unit DT</text><text class="comparison-axis" transform="translate(14 140) rotate(-90)" text-anchor="middle">Speed (km/jam)</text>
    </svg>
  </div><% } %><p class="comparison-help">Arahkan kursor ke batang untuk melihat nilai atau klik untuk membuka laporan DT. <span data-comparison-scroll-help hidden>Geser mendatar untuk melihat unit berikutnya.</span></p><% } else { %><p class="speed-empty">Belum ada unit berdata pada periode ini. Ubah tanggal filter atau tambahkan rekap.</p><% } %>
  <span class="sr-only" data-comparison-status role="status"></span>
</section>
