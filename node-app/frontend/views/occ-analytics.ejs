<% const available=occAvailability.filter(r=>r.work_date<=(occFilters.work_date||new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}))).map(r=>({row:r,value:occStatusSummary(r.statuses,OCC_ITEMS)}));const ho=cctvData?.sites.find(s=>s.site==='HO'); %><div class="analytics-grid"><%- include('analytics-chart',{chart:{title:'Ketersediaan perangkat OCC',note:'Status pemeriksaan asli; belum dicek tidak dianggap OK',unit:'%',min:0,max:100,series:[{name:'Perangkat OK',color:'#16815c',data:available.map(({row,value})=>({x:row.work_date,y:value.checked?value.availability_percent:null,detail:value.ok+'/'+value.checked+' pemeriksaan OK'}))},{name:'Cakupan pemeriksaan',color:'#ca7219',data:available.map(({row,value})=>({x:row.work_date,y:value.completion_percent}))}]}}) %><%- include('analytics-chart',{chart:{title:'CCTV HO / JHO',note:'Ketersediaan kamera sesuai Sheet1 · '+(cctvData?dateId(cctvData.reference):'belum ada laporan'),unit:'%',min:0,max:100,threshold:60,series:[{name:'Availability CCTV',color:'#247da0',data:(ho?.series||[]).map(r=>({x:r.work_date,y:r.availability_percent,display:cctvPercent(r),detail:r.online_count+'/'+r.total_count+' ON'}))}]}}) %></div>
