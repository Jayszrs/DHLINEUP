<div class="speed-metrics"><% for(const [label,value,unit,tone] of [['Rata-rata semua',speedSummary.average,'km/jam','orange'],['Rata-rata bergerak',speedSummary.moving_average,'km/jam','green'],['Speed tertinggi',speedSummary.max_speed,'km/jam','amber'],['Catatan GPS dalam rekap',speedSummary.total_count,'catatan','blue']]) { %><article class="metric-card <%= tone %>"><span><%= label %></span><strong><%= speedNumber(value,unit==='catatan'?0:2) %> <small><%= unit %></small></strong><small><%= unit==='catatan'?'Jumlah pembacaan dalam rekap terpilih':label==='Rata-rata bergerak'?(speedSummary.moving_ratio===null?'Belum ada catatan':speedNumber(speedSummary.moving_ratio,1)+'% catatan bergerak'):'Periode sesuai filter tanggal' %></small></article><% } %></div>
