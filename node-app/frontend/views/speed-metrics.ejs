<div class="speed-metrics"><% for(const [label,value,unit] of [['Rata-rata semua',speedSummary.average,'km/jam'],['Rata-rata bergerak',speedSummary.moving_average,'km/jam'],['Speed tertinggi',speedSummary.max_speed,'km/jam'],['Catatan GPS dalam rekap',speedSummary.total_count,'catatan']]) { %><div><span><%= label %></span><strong><%= speedNumber(value,unit==='catatan'?0:2) %> <small><%= unit %></small></strong></div><% } %></div>
