<div class="section-title"><strong>Ringkasan periode</strong><small>Jumlah penugasan, bukan jam produksi.</small></div><div class="period-grid"><% for(const [name,period,items] of periods) { %><article class="period period-<%= name.toLowerCase() %>"><div class="period-head"><%= {DAILY:'Harian',WTD:'Minggu berjalan',MTD:'Bulan berjalan',YTD:'Tahun berjalan'}[name] %><span><%= period %></span></div><div class="period-body"><strong><%= items.length %><small> penugasan</small></strong><% for(const [key,label] of [['mine','Mine Dispatch'],['ftw','FTW terisi']]) {const count=yes(items,key),ratio=items.length?Math.round(count/items.length*100):null; %><div class="period-detail-row period-<%= key %>"><span><%= label %></span><b><%= count %>/<%= items.length %><small><%= ratio===null?'Belum ada data':ratio+'%' %></small></b></div><div class="period-meter <%= key==='mine'?'meter-green':'meter-gold' %>"><span style="width:<%= ratio??0 %>%"></span></div><% } %></div></article><% } %></div>
