<section class="panel occ-meetings" aria-labelledby="occ-meetings-title"><div class="section-heading"><div><h3 id="occ-meetings-title">Jadwal meeting OCC</h3><p>Ruang OCC Jakarta Head Office · seluruh waktu WIB</p></div><% if(canEditData){ %><a class="btn primary" href="<%= url('occ-meeting-form',{day:meetingDay}) %>">Jadwalkan meeting</a><% } %></div>
<form method="get" action="<%= url('occ-dashboard') %>" class="meeting-day-filter"><label>Tanggal meeting<input type="date" name="meeting_date" value="<%= meetingDay %>" required></label><button type="submit" class="subtle-button">Lihat jadwal</button></form>
<% if(!meetings.length){ %><div class="meeting-empty"><strong>Belum ada meeting pada <%= dateId(meetingDay) %></strong><p>Jadwal yang disimpan beserta link meeting akan tampil di sini.</p></div><% } else { %><ol class="meeting-list"><% for(const meeting of meetings){ %><li><div class="meeting-time"><strong><%= meetingTime(meeting.start_at) %>–<%= meetingTime(meeting.end_at) %></strong><small>WIB</small></div><div class="meeting-info"><h4><%= meeting.title %></h4><% if(meeting.notes){ %><p><%= meeting.notes %></p><% } %><% if(meeting.meeting_url){ %><a class="table-action" href="<%= meeting.meeting_url %>" target="_blank" rel="noopener noreferrer">Buka link meeting ↗</a><% }else{ %><span class="muted">Link meeting belum ditambahkan</span><% } %></div><% if(canEditData){ %><a class="subtle-button" href="<%= url('occ-meeting-form',{id:meeting.id}) %>">Edit jadwal</a><% } %></li><% } %></ol><% } %></section>
