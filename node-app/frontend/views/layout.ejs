<!doctype html><html lang="id" data-theme="light"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark">
<title><%= label %> | DH FleetSync</title><link rel="icon" href="<%= asset('dh-logo.png') %>">
<script src="<%= asset('js/theme.js') %>"></script><link rel="stylesheet" href="<%= asset('css/app.css') %>"><script src="<%= asset('js/app.js') %>" defer></script>
</head><body data-upload-mode="<%= storageMode %>"><a class="skip-link" href="#main-content">Lewati ke konten</a>
<% if(user) { %><div class="app-shell"><aside class="sidebar" id="sidebar" aria-label="Navigasi utama">
<a class="brand" href="<%= url('dashboard') %>"><img src="<%= asset('dh-logo.png') %>" alt="DH"><div class="brand-caption">FLEETSYNC</div></a>
<button class="sidebar-close icon-button" id="nav-close" type="button" aria-label="Tutup navigasi"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><p class="workspace-label">WORKSPACE</p>
<nav><% for(const [destination,text] of Object.entries({dashboard:'Dashboard',lineup:'DH Line Up',master:'Master Operator',import:'Impor Excel',dokumentasi:'Dokumentasi',audit:'Riwayat Perubahan',accounts:'Kelola Akun'})) { const active=destination===page||(destination==='lineup'&&['detail','lineup-form'].includes(page))||(destination==='master'&&page==='operator-form'); %>
<a class="nav-item <%= active?'active':'' %>" href="<%= url(destination) %>" <%- active?'aria-current="page"':'' %>><%= text %></a><% } %></nav>
<div class="sidebar-foot"><span class="dot"></span>DATA TERSIMPAN DI SERVER<small>Perubahan disimpan ke PostgreSQL.<br>Tidak tersinkron ke Mine Dispatch.</small></div></aside>
<button class="sidebar-backdrop" id="nav-backdrop" aria-label="Tutup menu" hidden></button>
<main class="main-shell" id="main-content"><header class="topbar"><div class="topbar-left">
<button class="icon-button" id="nav-toggle" type="button" aria-label="Buka navigasi" aria-expanded="true" aria-controls="sidebar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><span class="operational-label">Operasional</span><span class="slash">/</span><strong><%= label %></strong></div>
<div class="topbar-right"><button class="icon-button theme-toggle" id="theme-toggle" type="button" aria-label="Aktifkan mode gelap"><svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z"/></svg><svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg></button>
<a class="subtle-button header-import" href="<%= url('import') %>">Impor Excel</a><a class="top-add" href="<%= url('lineup-form') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span class="add-label">Input Line Up</span><span class="sr-only mobile-add-label">Input Line Up</span></a>
<details class="profile-menu"><summary aria-label="Menu akun <%= user.name %>"><span class="avatar"><%= [...user.name][0]?.toUpperCase() %></span><span class="signed-in"><%= user.name %></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
<div class="profile-dropdown"><div class="profile-identity"><strong><%= user.name %></strong><small>@<%= user.username %> / <%= user.is_admin?'Administrator':ROLE %></small></div><a href="<%= url('profile') %>">Edit profil</a><a href="<%= url('profile') %>#password-title">Ganti password</a><a href="<%= url('accounts') %>">Kelola akun</a><form method="post" action="<%= url('logout') %>"><input type="hidden" name="csrf" value="<%= csrf %>"><button type="submit">Keluar</button></form></div></details></div></header>
<div class="page-content"><% if(flash) { %><div class="alert <%= flash.type %>" role="status"><%= flash.message %><button type="button" data-dismiss aria-label="Tutup notifikasi">&times;</button></div><% } %>
<% if(errorMessage) { %><div class="alert error" role="alert"><%= errorMessage %><p>Data belum tersimpan. Periksa isian lalu coba lagi.</p></div><% } %><%- include('pages/'+page) %></div></main></div>
<% } else { %><main id="main-content" class="guest-shell"><div class="guest-brand"><img src="<%= asset('dh-logo.png') %>" alt="DH"><span>FLEETSYNC</span></div><section class="guest-panel"><% if(flash) { %><div class="alert <%= flash.type %>" role="status"><%= flash.message %></div><% } %><% if(errorMessage) { %><div class="alert error" role="alert"><%= errorMessage %><% if(retryAfter) { %><p data-retry-after="<%= retryAfter %>" aria-live="off">Bisa dicoba lagi dalam <span data-retry-count><%= retryAfter %></span> detik.</p><% } %></div><% } %><%- include('pages/'+page) %></section></main><% } %>
<dialog class="image-dialog" id="image-dialog" aria-label="Gambar bukti diperbesar"><div class="lightbox"><header><strong id="image-title">Bukti dokumentasi</strong><button type="button" class="subtle-button" id="image-close">Tutup</button></header><img id="image-full" alt=""></div></dialog>
<div class="loading-status" id="loading-status" role="status" hidden>Menyimpan perubahan. Mohon tunggu...</div></body></html>
