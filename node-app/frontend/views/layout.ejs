<!doctype html><html lang="id" data-theme="light"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark">
<title><%= label %> | DH Operation Command Center</title><link rel="icon" type="image/svg+xml" href="<%= asset('dh-symbol.svg') %>"><link rel="apple-touch-icon" href="<%= asset('dh-symbol.svg') %>">
<script src="<%= asset('js/theme.js') %>"></script><link rel="stylesheet" href="<%= asset('css/app.css') %>"><script src="<%= asset('js/app.js') %>" defer></script>
<link rel="stylesheet" href="<%= asset('css/dhocc.css') %>">
<link rel="stylesheet" href="<%= asset('css/monitoring.css') %>">
<link rel="stylesheet" href="<%= asset('css/analytics.css') %>"><script type="module" src="<%= asset('js/analytics-charts.js') %>"></script>
<link rel="stylesheet" href="<%= asset('css/brand-type.css') %>">
<% if(occPage==='occ-form'||occPage==='occ-assets'){ %><link rel="stylesheet" href="<%= asset('css/occ-asset-form.css') %>"><% } %>
<% if(occPage==='occ-form'){ %><script type="module" src="<%= asset('js/occ-asset-form.js') %>"></script><% } %>
<% if(page==='cctv'||occPage==='occ-availability'){ %><script type="module" src="<%= asset('js/visual-controls.js') %>"></script><% } %>
<% if(page==='cctv-form'){ %><script type="module" src="<%= asset('js/cctv-form.js') %>"></script><% } %>
<% if(speedPage==='speed-dashboard') { %><link rel="stylesheet" href="<%= asset('js/vendor/leaflet/leaflet.css') %>"><link rel="stylesheet" href="<%= asset('css/fleet-map.css') %>"><script type="module" src="<%= asset('js/fleet-map.js') %>"></script><% } %>
<% if(speedPage==='speed-unit') { %><link rel="stylesheet" href="<%= asset('css/unit-showcase.css') %>"><script type="module" src="<%= asset('js/unit-showcase.js') %>"></script><% } %>
<% if(page==='dashboard'||speedPage==='speed-dashboard'||occPage==='occ-dashboard') { %><script type="module" src="<%= asset('js/fleet-scene.js') %>"></script><script src="<%= asset('js/fleet-explorer.js') %>" defer></script><script type="module" src="<%= asset('js/visual-controls.js') %>"></script><% } %>
<% if(['lineup-form','operator-form'].includes(page)) { %><script src="<%= asset('js/equipment-select.js') %>" defer></script><% } %>
<% if(speedPage==='speed-dashboard') { %><script src="<%= asset('js/speed-dashboard.js') %>" defer></script><% } %>
<% if(page==='speed-import') { %><script src="<%= asset('js/speed-import.js') %>" defer></script><% } %>
<% if(page==='three-d') { %><link rel="stylesheet" href="<%= asset('css/dh-premium-3d.css') %>"><script type="module" src="<%= asset('js/dh3d/dh-premium-viewer.js') %>"></script><% } %>
</head><body data-upload-mode="<%= storageMode %>"><a class="skip-link" href="#main-content">Lewati ke konten</a>
<% if(user) { %><div class="app-shell"><aside class="sidebar" id="sidebar" aria-label="Navigasi utama">
<a class="brand brand-dh" href="<%= url('dashboard') %>" aria-label="DH Operation Command Center, buka Dashboard"><span class="brand-signature"><img src="<%= asset('dh-symbol.svg') %>" alt="" width="48" height="48"><span class="brand-wordmark brand-occ-name">DH</span></span><span class="brand-caption">Operation Command Center</span></a>
<button class="sidebar-close icon-button" id="nav-close" type="button" aria-label="Tutup navigasi"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><p class="workspace-label">WORKSPACE</p>
<nav><details class="nav-group" <%= ['dashboard','lineup','master','audit','accounts','detail','lineup-form','operator-form','import','account-edit','account-reset'].includes(page)?'open':'' %>><summary class="nav-item"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 10h16M10 10v10"/></svg><span>Recap DH Line Up</span><svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="nav-children"><% for(const [destination,text] of Object.entries({dashboard:'Dashboard',lineup:'DH Line Up',master:'Operator',audit:'Riwayat Perubahan',accounts:'Kelola Akun'})) { const active=destination===page||(destination==='lineup'&&['detail','lineup-form','import'].includes(page))||(destination==='master'&&page==='operator-form')||(destination==='accounts'&&['account-edit','account-reset'].includes(page)); %><a class="nav-item <%= active?'active':'' %>" href="<%= url(destination) %>" <%- active?'aria-current="page"':'' %>><%= text %></a><% } %></div></details>
<details class="nav-group" <%= ['speed','speed-form','speed-import'].includes(page)?'open':'' %>><summary class="nav-item"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4v16h16M8 15v-4m4 4V7m4 8v-6"/></svg><span>Recap Fleet Speed Monitoring</span><svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="nav-children"><% for(const [destination,text] of Object.entries({'speed-dashboard':'Dashboard','speed-daily':'Rekap Harian','speed-monthly':'Rekap Bulanan','speed-units':'Daftar Unit'})) { const selected=speedPage===destination||(destination==='speed-dashboard'&&speedPage==='speed-import')||(destination==='speed-units'&&['speed-unit','speed-form'].includes(speedPage)); %><a class="nav-item <%= selected?'active':'' %>" href="<%= url(destination,typeof speedFilters!=='undefined'?speedFilters:{}) %>" <%- selected?'aria-current="page"':'' %>><%= text %></a><% } %></div></details><%- include('occ-navigation') %></nav>
<div class="sidebar-foot"><span class="dot"></span>DATA TERSIMPAN DI SERVER<small>Perubahan disimpan ke PostgreSQL.<br>Tidak tersinkron ke Mine Dispatch.</small></div></aside>
<button class="sidebar-backdrop" id="nav-backdrop" aria-label="Tutup menu" hidden></button>
<main class="main-shell" id="main-content"><header class="topbar"><div class="topbar-left">
<button class="icon-button" id="nav-toggle" type="button" aria-label="Buka navigasi" aria-expanded="true" aria-controls="sidebar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><span class="operational-label">Operasional</span><span class="slash">/</span><strong><%= label %></strong></div>
<div class="topbar-right"><button class="icon-button theme-toggle" id="theme-toggle" type="button" aria-label="Aktifkan mode gelap"><svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z"/></svg><svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg></button>
<% if(canEditData&&!['speed','speed-form','speed-import','occ','occ-form','occ-meeting','occ-documentation','occ-team-form','cctv','cctv-form'].includes(page)) { %><a class="top-add" href="<%= url('lineup-form') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span class="add-label">Input Line Up</span><span class="sr-only mobile-add-label">Input Line Up</span></a>
<% } %><details class="profile-menu"><summary aria-label="Menu akun <%= user.name %>"><span class="avatar"><% if(user.profile_photo) { %><img src="<%= avatarUrl(user) %>" alt="" width="34" height="34"><% } else { %><%= [...user.name][0]?.toUpperCase() %><% } %></span><span class="signed-in"><%= user.name %></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
<div class="profile-dropdown"><div class="profile-identity"><strong><%= user.name %></strong><small>@<%= user.username %> / <%= user.is_admin?'Administrator':ROLE %></small></div><a href="<%= url('profile') %>">Edit profil</a><a href="<%= url('profile') %>#password-title">Ganti password</a><a href="<%= url('accounts') %>">Kelola akun</a><form method="post" action="<%= url('logout') %>"><input type="hidden" name="csrf" value="<%= csrf %>"><button type="submit">Keluar</button></form></div></details></div></header>
<div class="page-content"><% if(flash) { %><div class="alert <%= flash.type %>" role="status"><%= flash.message %><button type="button" data-dismiss aria-label="Tutup notifikasi">&times;</button></div><% } %>
<% if(errorMessage) { %><div class="alert error" role="alert"><%= errorMessage %><p>Data belum tersimpan. Periksa isian lalu coba lagi.</p></div><% } %><%- include('pages/'+page) %></div></main></div>
<% } else { %><%- include('guest') %><% } %>
<dialog class="image-dialog" id="image-dialog" aria-label="Gambar bukti diperbesar"><div class="lightbox"><header><strong id="image-title">Bukti dokumentasi</strong><button type="button" class="subtle-button" id="image-close">Tutup</button></header><div id="image-slot"></div></div></dialog>
<div class="loading-status" id="loading-status" role="status" hidden>Menyimpan perubahan. Mohon tunggu...</div></body></html>
