<% const split=['login','forgot-password','reset-password'].includes(page); %>
<main id="main-content" class="<%= split?'login-shell':'guest-shell' %>">
<% if(split) { %>
  <aside class="login-visual" aria-label="DH Operation Command Center">
    <img class="login-photo" src="<%= asset('login-mine-hd.png') %>" alt="" fetchpriority="high" decoding="async">
    <div class="login-visual-shade" aria-hidden="true"></div>
    <div class="login-brand brand-dh"><span class="brand-signature"><img src="<%= asset('dh-symbol.svg') %>" alt="" width="48" height="48"><span class="brand-wordmark brand-occ-name">DH</span></span><span class="brand-caption">Operation Command Center</span></div>
    <div class="login-visual-copy"><h2>Penugasan operator<br>dan pengecekan harian.</h2><p>Kelola Line Up, Mine Dispatch, dan bukti FTW untuk operasional site.</p></div>
    <p class="login-visual-footer">DH · Operation Command Center</p>
  </aside>
<% } else { %><div class="guest-brand brand-dh" aria-label="DH Operation Command Center"><span class="brand-signature"><img src="<%= asset('dh-symbol.svg') %>" alt="" width="56" height="56"><span class="brand-wordmark brand-occ-name">DH</span></span><span class="brand-caption">Operation Command Center</span></div><% } %>
  <section class="guest-panel <%= split?'login-panel':'' %>"><div class="<%= split?'login-form-area':'' %>">
    <% if(flash) { %><div class="alert <%= flash.type %>" role="status"><%= flash.message %></div><% } %>
    <% if(errorMessage) { %><div class="alert error" role="alert"><%= errorMessage %><% if(retryAfter) { %><p data-retry-after="<%= retryAfter %>" aria-live="off">Bisa dicoba lagi dalam <span data-retry-count><%= retryAfter %></span> detik.</p><% } %></div><% } %>
    <%- include('pages/'+page) %>
  </div></section>
</main>
