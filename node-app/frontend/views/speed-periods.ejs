<div class="section-title"><strong>RINGKASAN PERIODE</strong><small>Acuan: <%= speedDaily.length?dateId(speedDaily.at(-1).work_date):'belum ada data' %>. Mengikuti filter tanggal.</small></div>
<div class="period-grid speed-period-grid"><% for(const p of speedPeriods) { %>
 <article class="period period-<%= p.name.toLowerCase() %>"><div class="period-head"><%= p.name %><span><%= p.to?dateId(p.to,true):'Belum ada data' %></span></div><div class="period-body"><strong><%= speedNumber(p.average) %> <small>km/jam</small></strong><span class="period-description">Rata-rata semua</span><div class="period-detail-row"><span>Rata-rata bergerak</span><b><%= speedNumber(p.moving_average) %><small>km/jam</small></b></div><div class="period-detail-row"><span>Catatan GPS</span><b><%= speedNumber(p.total_count,0) %></b></div><div class="period-moving"><b><%= p.moving_ratio===null?'Belum ada data':speedNumber(p.moving_ratio,1)+'%' %></b><span>catatan bergerak</span></div><div class="period-meter"><span style="width:<%= p.moving_ratio??0 %>%"></span></div></div></article>
<% } %></div>
