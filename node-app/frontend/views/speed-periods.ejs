<div class="section-title"><strong>RINGKASAN PERIODE</strong><small>Acuan: <%= speedDaily.length?dateId(speedDaily.at(-1).work_date):'belum ada data' %>. Mengikuti filter tanggal.</small></div>
<div class="period-grid speed-period-grid"><% for(const p of speedPeriods) { %>
 <article class="period period-<%= p.name.toLowerCase() %>"><div class="period-head"><%= p.name %><span><%= p.to?dateId(p.to,true):'Belum ada data' %></span></div><div class="period-body"><strong><%= speedNumber(p.average) %> <small>km/jam</small></strong><span class="period-description">Rata-rata semua</span><div class="period-measures"><div class="percent-ring" style="--percent:<%= p.moving_ratio??0 %>" aria-label="<%= p.moving_ratio===null?'Belum ada catatan':speedNumber(p.moving_ratio,1)+' persen catatan bergerak' %>"><b><%= p.moving_ratio===null?'—':speedNumber(p.moving_ratio,1)+'%' %></b><small>bergerak</small></div><div><span>Bergerak <b><%= speedNumber(p.moving_average) %> km/jam</b></span><span>Catatan <b><%= speedNumber(p.total_count,0) %></b></span></div></div></div></article>
<% } %></div>
