<div class="table-outer"><div class="table-scroll"><table class="data-table speed-table"><caption class="sr-only"><%= tableTitle %></caption><thead><tr><th><%= firstLabel %></th><% if(showUnits) { %><th>Unit aktif</th><% } %><th>Catatan</th><th>Bergerak</th><th>Berhenti (0)</th><th>Σ Speed</th><th>Rata-rata semua</th><th>Rata-rata bergerak</th><th>Speed tertinggi</th><th>% Bergerak</th><% if(showActions) { %><th>Aksi</th><% } %></tr></thead><tbody>
<% for(const r of tableRows) { %><tr><td><% if(firstLabel==='Unit') { %><a class="record-link unit-label" href="<%= url('speed-unit',{unit:r.unit}) %>"><%= r.unit %></a><% } else if(r.month) { %><%= new Date(r.month+'-01T00:00:00Z').toLocaleDateString('id-ID',{month:'long',year:'numeric',timeZone:'UTC'}) %><% } else { %><%= dateId(r.work_date) %><% } %></td><% if(showUnits) { %><td><%= speedNumber(r.active_units,0) %></td><% } %>
<td><%= r.total_count?speedNumber(r.total_count,0):'—' %></td><td><%= r.total_count?speedNumber(r.moving_count,0):'—' %></td><td><%= r.total_count?speedNumber(r.stopped_count,0):'—' %></td><td><%= r.total_count?speedNumber(r.speed_sum):'—' %></td><td><%= speedNumber(r.average) %></td><td><%= speedNumber(r.moving_average) %></td><td><%= speedNumber(r.max_speed) %></td><td><%= speedNumber(r.moving_ratio,1) %><%= r.moving_ratio!==null?'%':'' %></td>
<% if(showActions) { %><td><a class="table-action" href="<%= url('speed-form',{unit:speedFilters.unit,work_date:r.work_date}) %>">Edit rekap</a></td><% } %></tr><% } %>
</tbody></table><% if(!tableRows.length) { %><div class="empty-state"><h3>Belum ada rekap pada periode ini</h3><p>Ubah tanggal filter atau buka Daftar Unit untuk memeriksa laporan DT.</p></div><% } %></div></div>
